import './campaign.css';
import {reconcileLocationDom} from './location-dom.ts';
import {applyMilestones} from './current-campaign.ts';
import * as M from '../engine/campaign.ts';
import type {Action, Scenario} from '../schema/campaign.ts';
import {scenarios,featuredScenarioIds,presentationFor} from './campaign-page-catalogue.ts';
import {archivedScenarioIds} from '../schema/lifecycle.ts';
import {toLegacyGame} from '../compatibility/v1.ts';
import {decodeSave} from './save-codec.ts';
import {createAutosave, installSaveLifecycle} from './save-autosave.ts';
const app=document.querySelector<HTMLDivElement>('#app')!;
const esc=(s:unknown)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const id=new URLSearchParams(location.search).get('world');
// Archived experiments remain addressable by their original URLs, but are not
// recommendations in the active chooser. Do not delete their scenario data.
const activeScenarios=scenarios.filter(s=>!archivedScenarioIds.has(s.id));
const developedIds=featuredScenarioIds;
const featuredScenarios=developedIds.flatMap(id=>activeScenarios.filter(s=>s.id===id));
const secondaryScenarios=activeScenarios.filter(s=>!developedIds.includes(s.id));
const journeyLink=(s:Scenario)=>`<a href="?world=${encodeURIComponent(s.id)}"><b>${esc(presentationFor(s).title)}</b><p>${esc(presentationFor(s).premise)}</p></a>`;
const scenario=scenarios.find(s=>s.id===id);
if(!scenario){app.innerHTML=`<section class="chooser"><h1>Combination journeys</h1><p>Six development focuses, including a short purpose workshop. Try them, then tell me where discovery turns into guesswork or busywork.</p>${featuredScenarios.map(journeyLink).join('')}${secondaryScenarios.length?`<details class="secondary-journeys"><summary>Earlier versions and experiments</summary><p>Preserved snapshots and early sketches, outside the current development focus.</p>${secondaryScenarios.map(journeyLink).join('')}</details>`:''}<a href="mars-expedition.html">Original Mars checkpoint</a></section>`;}else start(applyMilestones(scenario));
function start(s:Scenario){
 const key='tangible-campaign-v1:'+s.id;
 const width=()=>Math.max(320,Math.min(s.locationPlan?390:600,document.querySelector<HTMLElement>('.board')?.clientWidth??innerWidth));
 let game=M.createGame(s,width()),tops:Record<string,number>={[game.state.currentLocation]:0},seen:number[]=[],reading='',modal=true,last:M.Result|null=null,storageWarning='',debugName='',debugOpen=false,modalScrollOnClose=true;
 try{const raw=localStorage.getItem(key);if(raw){const saved=decodeSave(raw);game=M.resolveChapterEntry(s,M.restore(s,JSON.stringify(saved.game)));tops=saved.tops;seen=saved.seen;debugName=saved.debugName??'';modal=s.locationPlan?!!M.pendingEntryCue(s,game):!seen.includes(game.state.chapter);}}catch{storageWarning='The previous prototype save could not be loaded. A new journey is ready.';}
 let dragging:null|{id:string;el:HTMLElement;x:number;y:number;moved:boolean;pointer:number;touch?:number;stationary?:boolean;doubleTap?:boolean;tapCancelled?:boolean}=null;
 const boundBoards=new WeakSet<HTMLElement>();
 let navigationRequest=0,pendingPresentation:number|null=null,milestoneOpen='',milestoneReplay=false,missionAfterMilestones=false;
 let ignoreDoubleClickUntil=0;
 let lastTap:null|{id:string;x:number;y:number;time:number}=null;
 const DOUBLE_TAP_MS=360,DRAG_THRESHOLD=8,DOUBLE_TAP_DISTANCE=24;
 let edge:ReturnType<typeof setTimeout>|null=null,lastPointer:{x:number;y:number}|null=null;
 const autosave=createAutosave({key,onStatus:()=>updateSaveStatus()});
 // Save acknowledgements update only their own nodes: no render, drag cancellation,
 // modal reopening, or optimistic claim that an uncommitted snapshot is durable.
 function updateSaveStatus(){const status=autosave.getStatus(),e=document.getElementById('save-status'),retry=document.getElementById('retry-save'),alert=document.getElementById('save-alert'),bug=document.getElementById('debug-toggle');if(status.state==='saved')storageWarning='';if(e){e.textContent=status.state==='error'?status.message:storageWarning||status.message;e.dataset.state=status.state;}if(retry)retry.hidden=status.state!=='error';if(alert){alert.hidden=status.state!=='error'&&!storageWarning;alert.setAttribute('aria-label',(status.state==='error'?status.message:storageWarning)+' Open save controls.');}if(bug){bug.dataset.saveError=String(status.state==='error'||!!storageWarning);bug.setAttribute('aria-label',status.state==='error'||storageWarning?'Debug controls — progress needs attention':'Debug controls');}}
 const save=()=>autosave.enqueue(()=>({game:toLegacyGame(game),tops,seen,...(debugName?{debugName}:{})}));
 const label=(i:string,ownerLocation?:string)=>i.startsWith('@')?s.hotspots.find(p=>p.id===i.slice(1))?.label??i:M.itemDisplayLabel(s,game.state,M.token(game.state,i)?.kind??i,ownerLocation);
 const height=(t:M.Token)=>M.tokenHeight(s,t);
 const locationBottom=(location:string)=>M.locationPanelHeight(s)??Math.max(80,...game.state.tokens.filter(t=>t.location===location).map(t=>t.y+height(t)/2+12),...game.state.hotspots.filter(p=>p.location===location).map(p=>p.y+50));
 // Existing tops are lower bounds, not a promise that an earlier location never
 // grows. Keep their visual order; append new locations and push only overlaps down.
 // Local token/hotspot coordinates and game history remain entirely model-owned.
 function ensureTops(scroll:number){
  if(s.locationPlan){game.state.locations.forEach((location,index)=>tops[location.id]=index*s.locationPlan!.panel.height);return scroll;}
  const ordered=[...game.state.locations].sort((a,b)=>(tops[a.id]??Infinity)-(tops[b.id]??Infinity));
  const anchor=[...ordered].reverse().find(a=>tops[a.id]!==undefined&&tops[a.id]<=scroll);
  const anchorTop=anchor?tops[anchor.id]:0;let floor=0;
  for(const a of ordered){tops[a.id]=Math.max(tops[a.id]??55,floor);floor=tops[a.id]+locationBottom(a.id)+55;}
  return scroll+(anchor?tops[anchor.id]-anchorTop:0);
 }
 function stopDrag(){if(edge!==null)clearTimeout(edge);edge=null;lastPointer=null;const owned=dragging;dragging=null;owned?.el.classList.remove('pressed','dragging');clear();app.classList.remove('is-dragging');
  // A persistent board no longer releases capture by being destroyed. Clear our
  // state first so a synchronous lostpointercapture cannot re-enter cancellation.
  const board=document.querySelector<HTMLElement>('.board');if(owned&&owned.touch===undefined&&board?.hasPointerCapture?.(owned.pointer))board.releasePointerCapture(owned.pointer);
 }
 function notify(text:string){const e=document.querySelector<HTMLElement>('.feedback');if(e){e.textContent=text;e.hidden=false;setTimeout(()=>{if(e.isConnected)e.hidden=true;},4500);}}
 function scrollLocation(){const v=document.querySelector<HTMLElement>('.viewport');if(v)v.scrollTop=tops[game.state.currentLocation]??0;}
 function commit(a:Action){if(milestoneOpen)return;if(a.type==='advance'&&M.pendingMilestone(s,game)){modal=false;presentWhenUnblocked(navigationRequest);return;}if(a.type==='advance'&&modal)game=M.acknowledgeChapterBridges(s,game,M.pendingChapterBridges(s,game).map(b=>b.id));navigationRequest++;pendingPresentation=null;reading='';lastTap=null;const old=game.state.chapter,oldStoryLocation=game.state.storyLocation??s.chapters[old].location.id,oldTravelCue=game.state.travelCue?.id,wasCompleted=game.state.completed;const result=M.applyAction(s,game,a);last=result;game=result.game;if(game.state.chapter!==old){modal=true;debugOpen=false;modalScrollOnClose=!s.locationPlan||oldStoryLocation!==(game.state.storyLocation??s.chapters[game.state.chapter].location.id);}else if(game.state.travelCue?.id!==oldTravelCue&&M.pendingEntryCue(s,game)){modal=true;debugOpen=false;modalScrollOnClose=true;}else if(!wasCompleted&&game.state.completed){modal=true;debugOpen=false;modalScrollOnClose=false;}// The shared engine already bypassed chapters completed on entry.
  render();save();if(!result.accepted&&/^(Make room around|This location needs room)/.test(result.message))notify(result.message);if(a.type==='visit'||a.type==='advance'&&result.accepted&&modalScrollOnClose)scrollLocation();
  if((a.type!=='advance'||result.accepted)&&game.state.chapter===old&&M.pendingMilestone(s,game)){
   const request=navigationRequest;
   // Let the tangible creation finish before its automatic, once-only wonder.
   // Chapter progression is always a separate explicit arrow action.
   setTimeout(()=>presentWhenUnblocked(request),700);
  }
 }

 // Read/replay is deliberate UI, never a game action. Only automatic wonders
 // queue behind an open dialog or gesture; completion never queues an advance.
 function presentWhenUnblocked(request:number){
  if(request!==navigationRequest)return;
  if(modal||debugOpen||reading||dragging||milestoneOpen){pendingPresentation=request;return;}
  const milestone=M.pendingMilestone(s,game);
  if(milestone){pendingPresentation=request;milestoneOpen=milestone.id;render();return;}
  pendingPresentation=null;if(missionAfterMilestones){missionAfterMilestones=false;modal=true;render();save();}
 }
 function resumePresentation(){if(pendingPresentation!==null){const request=pendingPresentation;pendingPresentation=null;setTimeout(()=>presentWhenUnblocked(request),0);}}
 // Replay availability is observational, separate from earned/acknowledged rewards.
 // A new authored explanation can cover a genuinely created object in an old save
 // without fabricating an achievement or an automatic backlog. Recipe-use evidence
 // survives bounded event/Undo history; merely supplying a primitive is not creation.
 function wonderForItem(id:string){
  const t=M.token(game.state,id);if(!t)return null;
  const definition=s.milestones?.find(m=>m.item===t.kind&&(game.state.milestones?.some(e=>e.id===m.id)||(m.when==='created'?s.recipes.some(r=>r.out===t.kind&&game.state.recipesUsed.includes(r.id)):!!m.capability&&M.capabilities(s,t).includes(m.capability))));
  if(!definition)return null;
  const earned=game.state.milestones?.find(e=>e.id===definition.id);
  return {...definition,components:earned?.components??[...new Set([...Object.values(t.slots),...(t.components??[])])]};
 }
 function openItem(id:string){if(dragging?.moved||modal||debugOpen||milestoneOpen||reading||!M.token(game.state,id))return;lastTap=null;const wonder=wonderForItem(id);if(wonder){milestoneOpen=wonder.id;milestoneReplay=true;}else reading=id;render();}
 function closeReading(){const id=reading;reading='';render();el(id)?.focus({preventScroll:true});resumePresentation();}
 function openDebug(){if(milestoneOpen)return;lastTap=null;reading='';debugOpen=true;modal=false;render();}
 // Inspecting an older object never visits its location or changes progress.
 function visit(location:string,carry:string[]=[]){const from=carry.length?M.token(game.state,carry[0])?.location:undefined;if(from&&from!==game.state.currentLocation)visit(from,[]);if(location===game.state.currentLocation)return;const r=M.applyAction(s,game,{type:'visit',location,carry});if(r.accepted){game=r.game;save();};}
 function drop(id:string,target:string){const location=target.startsWith('@')?game.state.hotspots.find(p=>p.id===target.slice(1))?.location:M.token(game.state,target)?.location;if(!location)return;if(s.locationPlan)commit({type:'drop',item:id,target});else{visit(location,[id]);commit(M.dropAction(s,game.state,id,target));}}
 function reset(){if(!confirm('Start this prototype again? Its saved progress will reset.'))return;navigationRequest++;pendingPresentation=null;milestoneOpen='';milestoneReplay=false;missionAfterMilestones=false;lastTap=null;reading='';stopDrag();game=M.createGame(s,width());tops={[game.state.currentLocation]:0};seen=[];modal=true;debugOpen=false;modalScrollOnClose=true;last=null;debugName='';render();save();scrollLocation();}
 function openMission(){if(milestoneOpen)return;lastTap=null;reading='';modal=true;debugOpen=false;modalScrollOnClose=false;render();}
 function closeModal(expectedChapter=game.state.chapter,bridgeIds=M.pendingChapterBridges(s,game).map(b=>b.id)){if(expectedChapter!==game.state.chapter)return;game=M.acknowledgeChapterBridges(s,game,bridgeIds);const cue=M.currentEntryCue(s,game);if(cue)game=M.acknowledgeEntryCue(s,game,cue.id);seen=[...new Set([...seen,game.state.chapter])];modal=false;render();save();if(modalScrollOnClose)scrollLocation();document.getElementById('purpose')?.focus();resumePresentation();}
 function closeDebug(){debugOpen=false;render();document.getElementById('debug-toggle')?.focus();resumePresentation();}
 function closeMilestone(expected:string){
  if(milestoneOpen!==expected)return;
  if(milestoneReplay){const item=s.milestones?.find(m=>m.id===expected)?.item;milestoneOpen='';milestoneReplay=false;render();if(item)el(item)?.focus({preventScroll:true});resumePresentation();return;}
  const milestone=M.pendingMilestone(s,game);if(!milestone||milestone.id!==expected)return;
  game=M.acknowledgeMilestone(s,game,milestone.id);milestoneOpen='';render();save();
  (el(milestone.item)??document.getElementById('purpose'))?.focus({preventScroll:true});resumePresentation();
 }
 function render(scroll?:number){stopDrag();const prior=ensureTops(scroll??document.querySelector<HTMLElement>('.viewport')?.scrollTop??0);const marks=M.gold(s,game.state),view=M.playerView(s,game),goals=view.objectives,divisions=M.arrivalDivisions(game.state);
  const replayDefinition=milestoneReplay?s.milestones?.find(m=>m.id===milestoneOpen):null;
  const milestone=milestoneOpen?(replayDefinition?wonderForItem(game.state.tokens.find(t=>t.kind===replayDefinition.item)?.id??''):M.pendingMilestone(s,game)):null;
  const source=M.item(s,M.token(game.state,reading)?.kind??'');
  const cue=M.currentEntryCue(s,game);
  if(reading&&(!source||modal||debugOpen||milestoneOpen))reading='';
  // Finishing is a recorded event. Later exploration may move a placed object;
  // keep its ending readable as history, without claiming today's goal is met.
  const ending=view.completed?[...game.events].reverse().find(e=>e.accepted&&e.action.type==='advance'&&e.chapter===game.state.chapter)?.message:null;
  const closure=view.completed&&game.state.skippedChapters?.includes(s.chapters[game.state.chapter].id)?'Your earlier work has already brought this journey to its end. Your creations remain here.':view.completionText??(view.completed?ending?'At journey’s end: '+ending:'Journey complete. Your creations remain here.':view.canAdvance?'All objectives in this chapter are complete.':'');
  const extent=s.locationPlan?game.state.locations.length*s.locationPlan.panel.height:Math.max(...game.state.locations.map(a=>(tops[a.id]??0)+locationBottom(a.id)),(tops[game.state.currentLocation]??0)+(document.querySelector<HTMLElement>('.viewport')?.clientHeight??500));
  const next=view.canAdvance?M.applyAction(s,game,{type:'advance'}):null;
  const nextLocation=next?.accepted?next.game.state.storyLocation??s.chapters[next.game.state.chapter].location.id:s.chapters[game.state.chapter+1]?.location.id;
  const direction=nextLocation&&(game.state.storyLocation??s.chapters[game.state.chapter].location.id)!==nextLocation?'down':'right';
  const objectiveMarkup=`<div class="hud-stack ${s.locationPlan?'location-hud':''}">
   <div class="objective-dock"><button id="purpose" class="objective-overlay" aria-haspopup="dialog" aria-controls="mission" aria-label="${view.completed?'Read the ending':'Read the current challenge'}"><span class="objectives">${goals.map(g=>`<span class="objective-line ${g.satisfied?'done':''}">${g.satisfied?'✓':'○'} ${esc(g.text)}</span>`).join('')}</span></button>
   </div></div>`;
  const markup=`<button id="debug-toggle" class="debug-toggle" aria-label="Debug controls" aria-haspopup="dialog" aria-controls="debug-dialog" aria-expanded="${debugOpen}" title="Debug controls" data-debug="${!!debugName}"><svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 7 2m8 2 2-2M8 8h8v8a4 4 0 0 1-8 0V8Zm1 0V6a3 3 0 0 1 6 0v2M12 9v11M4 8l4 2m8 0 4-2M3 14h5m8 0h5M4 20l4-3m8 0 4 3"/></svg></button>
   <button id="save-alert" class="save-alert" hidden aria-haspopup="dialog" aria-controls="debug-dialog">Save needs attention</button>
   <section class="viewport" aria-label="Scrollable world"><main class="board ${s.locationPlan?'fixed-locations':''}" style="height:${extent}px">${objectiveMarkup}${game.state.locations.map(a=>{const setting=M.locationDefinition(s,a.id);return `${setting?`<div class="location-scene" data-location="${esc(a.id)}" data-background="${esc(setting.background.stableKey)}" aria-hidden="true" style="top:${tops[a.id]}px;height:${s.locationPlan!.panel.height}px">${setting.background.asset?`<img src="${esc(setting.background.asset)}" alt="" draggable="false" loading="eager" decoding="async" style="object-position:${(setting.background.focalPoint?.x??.5)*100}% ${(setting.background.focalPoint?.y??.5)*100}%"/>`:''}<div class="location-scrim"></div></div>`:''}<div class="location-label" data-scene-label="${esc(a.id)}" style="top:${tops[a.id]}px">${esc(a.label)}</div>`;}).join('')}${divisions.filter(d=>d.active&&d.chapter===game.state.chapter).map(division=>`<div class="arrival-divider" role="separator" aria-label="New items" style="top:${tops[division.location]+division.dividerY}px"><span>new items</span></div>`).join('')}${game.state.hotspots.map(p=>`<button class="hotspot ${marks.hotspots.includes(p.id)?'goal-met':''}" data-target="@${esc(p.id)}" style="left:${p.x}px;top:${tops[p.location]+p.y}px" aria-label="${esc(label('@'+p.id))}">${esc(label('@'+p.id))}</button>`).join('')}${game.state.tokens.map(t=>{const def=M.item(s,t.kind)!,displayLabel=M.itemDisplayLabel(s,game.state,t.kind),lines=M.itemLabelLayout({...def,label:displayLabel});const birth=last?.created===t.id;return `<button class="thing ${lines?'text-thing':''} ${def.reading?'reading-thing':''} ${marks.items.includes(t.id)?'goal-met':''} ${birth?'born':''}" data-target="${esc(t.id)}" style="left:${t.x}px;top:${tops[t.location]+t.y}px;min-height:${height(t)}px;${birth&&last?.origin?`--birth-x:${last.origin.x-t.x}px;--birth-y:${last.origin.y-t.y}px`:''}" aria-label="${esc(displayLabel)}${marks.items.includes(t.id)?' — objective completed':''}" aria-description="Double-tap to read or revisit its wonder">${def.reading?'<span class="source-marker" aria-hidden="true"><svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M8 3v10M8 3C6 1.5 3 2 1 2v10c2 0 5-.5 7 1 2-1.5 5-1 7-1V2c-2 0-5-.5-7 1Z"/></svg></span>':''}${lines?`<span class="item-label">${lines.map(line=>`<span class="item-label-line">${esc(line)}</span>`).join('')}</span>`:esc(displayLabel)}${(def.slots??[]).filter(sl=>sl.required||t.slots[sl.id]).map(sl=>`<span class="slot ${t.slots[sl.id]?'filled':''}">${t.slots[sl.id]?esc(label(t.slots[sl.id],t.location)):''}</span>`).join('')}${M.componentLabels(s,t,game.state).map(label=>`<span class="slot filled">${esc(label)}</span>`).join('')}</button>`;}).join('')}</main></section>
   ${view.canAdvance&&!modal&&!debugOpen&&!reading&&!milestoneOpen?`<button id="chapter-next" class="chapter-next ${direction}" data-direction="${direction}" aria-label="${next?.game.state.completed?'Finish this journey':direction==='down'?'Continue to the next location':'Continue the story'}"><span aria-hidden="true">${direction==='down'?'↓':'→'}</span></button>`:''}
   ${reading&&source?`<dialog id="source-reader" aria-labelledby="source-reader-title" aria-describedby="source-reader-text"><button id="reader-close" class="reader-dismiss" aria-label="Close reading" autofocus>×</button><p id="source-reader-text" class="reading-text">${esc(source.reading?.text??source.description??label(reading))}</p><em id="source-reader-title" class="result-caption">${esc(label(reading))}</em></dialog>`:''}
   ${milestone?`<dialog id="milestone" class="milestone ${milestone.presentation==='explanation'?'explanation-milestone':''} ${milestone.artwork?'illustrated-milestone':''}" aria-labelledby="milestone-title" aria-describedby="milestone-text"><div class="milestone-content">${milestone.presentation==='explanation'?`${milestone.artwork?`<img class="discovery-illustration" src="${esc(milestone.artwork.src)}" alt="${esc(milestone.artwork.alt)}" width="${milestone.artwork.width}" height="${milestone.artwork.height}"/>`:''}<p id="milestone-text">${esc(milestone.text)}</p><em id="milestone-title" class="result-caption">${esc(label(milestone.item))}</em>`:`<p class="milestone-eyebrow">${esc(milestone.eyebrow??'A new possibility')}</p>${milestone.artwork?`<img class="discovery-illustration" src="${esc(milestone.artwork.src)}" alt="${esc(milestone.artwork.alt)}" width="${milestone.artwork.width}" height="${milestone.artwork.height}"/>`:`<div class="milestone-object" role="img" aria-label="${esc(label(milestone.item))}"><span class="milestone-item-label">${esc(label(milestone.item))}</span>${milestone.components.map((id,i)=>`<span class="milestone-component" style="--part:${i}">${esc(label(id,game.state.tokens.find(t=>t.kind===milestone.item)?.location))}</span>`).join('')}</div>`}<h1 id="milestone-title">${esc(milestone.title)}</h1><p id="milestone-text">${esc(milestone.text)}</p>`}<button id="milestone-continue" autofocus>Continue</button></div></dialog>`:''}
   <p class="feedback" role="status" hidden></p>
   <dialog id="debug-dialog" aria-labelledby="debug-title"><div class="debug-heading"><h1 id="debug-title">Journey controls</h1><button id="debug-close" aria-label="Close debug controls">×</button></div><p class="debug-journey-title">${esc(s.title)}</p>${debugName?`<p class="debug-marker" title="This journey began from a replayed checkpoint, not a fresh start.">DEBUG · ${esc(debugName)}</p>`:''}<div class="debug-actions"><button id="undo" ${game.history.length?'':'disabled'}>Undo</button><button id="reset">Reset journey</button><button id="current">Current location</button></div><label for="travel">Visit an earlier location</label><select id="travel"><option value="">Choose an location…</option>${game.state.locations.map(a=>`<option value="${esc(a.id)}">${esc(a.label)} · ${view.locations.find(x=>x.id===a.id)?.thingCount??0} things</option>`).join('')}</select>${s.locationPlan?`<label for="inspect-thing">Find a thing in this location</label><select id="inspect-thing"><option value="">Choose a thing…</option>${game.state.tokens.filter(t=>t.location===game.state.currentLocation).map(t=>`<option value="${esc(t.id)}">${esc(label(t.id))}</option>`).join('')}</select>`:''}<label for="jump">Prepared checkpoint</label><select id="jump"><option value="">Replayed checkpoint…</option>${(s.checkpoints??[]).map(c=>`<option value="${esc(c.id)}">${esc(c.label)}</option>`).join('')}</select><nav class="debug-links"><a id="go-chooser" href="campaign.html">Choose a journey</a><a id="go-original" href="mars-expedition.html">Original Mars</a></nav><p class="save-controls"><span id="save-status" role="status"></span><button id="retry-save" hidden>Retry save</button></p><small>${game.state.metrics.combinations} successful combinations</small></dialog>
   ${!view.completed?`<dialog id="mission" class="intertitle" data-cue-id="${esc(cue?.id??'')}" data-format="intertitle" aria-label="Story" aria-describedby="mission-text"><button id="close" class="intertitle-dismiss" aria-label="Continue" autofocus>${cue?.contextHeading?`<em class="context-heading">${esc(cue.contextHeading)}</em>`:''}<span id="mission-text" class="motivation">${esc([...view.bridges.map(bridge=>bridge.text),cue?.text??view.chapter.motivation].filter(Boolean).join(' ').replace(/\s+/g,' ').trim())}</span></button></dialog>`:`<dialog id="mission" aria-labelledby="mission-title"><h1 id="mission-title">Journey complete</h1>${view.bridges.map(bridge=>`<p class="story-bridge">${esc(bridge.text)}</p>`).join('')}<p class="completion-story">${esc(closure)}</p><div class="dialog-actions"><button id="close">Explore your creations</button><button id="modal-reset" class="secondary">Start over</button></div></dialog>`}`;
  // The historical non-art routes retain their original renderer. Continuing
  // locations use connected keyed nodes, including the actual decoded images.
  if(s.locationPlan)reconcileLocationDom(app,markup);else app.innerHTML=markup;
  if(s.locationPlan){const owner=milestone?'milestone':modal?'mission':debugOpen?'debug-dialog':reading?'source-reader':'';document.querySelectorAll<HTMLDialogElement>('dialog').forEach(d=>{if(d.open&&d.id!==owner)d.close();});}
  const actualWidth=width();if(actualWidth!==game.state.width){game=M.resizeGame(game,actualWidth,s);render(prior);save();return;}
  bind();clear();updateSaveStatus();const v=document.querySelector<HTMLElement>('.viewport')!;v.scrollTop=prior;if(milestone){if(showDialog(document.querySelector<HTMLDialogElement>('#milestone')!,()=>closeMilestone(milestone.id)))document.getElementById('milestone-continue')?.focus({preventScroll:true});}else if(modal){const d=document.querySelector<HTMLDialogElement>('#mission')!;const shownChapter=game.state.chapter;showDialog(d,()=>closeModal(shownChapter,view.bridges.map(b=>b.id)));}else if(debugOpen){showDialog(document.querySelector<HTMLDialogElement>('#debug-dialog')!,closeDebug);}else if(reading){if(showDialog(document.querySelector<HTMLDialogElement>('#source-reader')!,closeReading))document.getElementById('reader-close')?.focus({preventScroll:true});}else if(last?.created){const t=M.token(game.state,last.created);if(t){const y=tops[t.location]+t.y;if(y+height(t)/2>v.scrollTop+v.clientHeight)v.scrollTop=y+height(t)/2+10-v.clientHeight;}}last=null;
 }
 function showDialog(d:HTMLDialogElement,close:()=>void){const opened=!d.open;if(opened)d.showModal();d.oncancel=e=>{e.preventDefault();close();};d.onclick=e=>{const r=d.getBoundingClientRect();if(e.target===d&&(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom))close();};return opened;}
 function el(id:string){return Array.from(document.querySelectorAll<HTMLElement>('[data-target]')).find(e=>e.dataset.target===id);}
 function clear(){document.querySelectorAll('[data-target]').forEach(e=>e.classList.remove('possible','will-create','will-place'));}
 function highlight(id:string){clear();const location=id.startsWith('@')?game.state.hotspots.find(p=>p.id===id.slice(1))?.location:M.token(game.state,id)?.location;if(!location)return;const p=M.partners(s,{...game.state,currentLocation:location},id),targets=[...p.partners,...p.settings,...p.incoming,...p.placements];if(targets.length)el(id)?.classList.add('possible');for(const x of targets)el(x)?.classList.add('possible');}
 function target(e:Element|null){return e?.closest<HTMLElement>('[data-target]')?.dataset.target;}
 function bind(){const on=(id:string,f:()=>void)=>{const e=document.getElementById(id);if(e)e.onclick=f;};const shownRequest=navigationRequest,shownMilestone=milestoneOpen,shownChapter=game.state.chapter,shownBridges=M.pendingChapterBridges(s,game).map(b=>b.id);on('milestone-continue',()=>closeMilestone(shownMilestone));on('purpose',openMission);on('debug-toggle',openDebug);on('save-alert',openDebug);on('reader-close',closeReading);on('debug-close',closeDebug);on('close',()=>closeModal(shownChapter,shownBridges));on('reset',reset);on('modal-reset',reset);on('chapter-next',()=>{if(navigationRequest===shownRequest&&game.state.chapter===shownChapter&&!modal&&!reading&&!debugOpen&&M.playerView(s,game).canAdvance)commit({type:'advance'});});on('retry-save',()=>{storageWarning='';autosave.retry();updateSaveStatus();});on('undo',()=>{navigationRequest++;pendingPresentation=null;milestoneOpen='';milestoneReplay=false;missionAfterMilestones=false;lastTap=null;reading='';last=M.undo(game);game=last.game;modal=false;render();save();if(M.pendingMilestone(s,game)){pendingPresentation=navigationRequest;resumePresentation();}});on('current',()=>{closeDebug();scrollLocation();});
  for(const id of ['go-chooser','go-original']){const link=document.getElementById(id) as HTMLAnchorElement;link.onclick=async e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();const request=++navigationRequest;pendingPresentation=null;reading='';try{await autosave.flush();if(request===navigationRequest)location.assign(link.href);}catch{notify('Progress is not saved. Retry saving before choosing another journey.');}};}
  document.querySelector<HTMLSelectElement>('#travel')!.onchange=e=>{const a=(e.target as HTMLSelectElement).value;(e.target as HTMLSelectElement).value='';if(a){visit(a);debugOpen=false;reading='';render();scrollLocation();document.getElementById('debug-toggle')?.focus();resumePresentation();}};
  const inspector=document.querySelector<HTMLSelectElement>('#inspect-thing');if(inspector)inspector.onchange=e=>{const id=(e.target as HTMLSelectElement).value,t=M.token(game.state,id);(e.target as HTMLSelectElement).value='';if(!t)return;lastTap=null;debugOpen=false;render();const viewport=document.querySelector<HTMLElement>('.viewport')!;viewport.scrollTop=Math.max(tops[t.location],tops[t.location]+t.y-viewport.clientHeight/2);el(id)?.focus({preventScroll:true});resumePresentation();};
  document.querySelector<HTMLSelectElement>('#jump')!.onchange=e=>{const id=(e.target as HTMLSelectElement).value;(e.target as HTMLSelectElement).value='';if(!id)return;navigationRequest++;pendingPresentation=null;milestoneOpen='';milestoneReplay=false;missionAfterMilestones=false;lastTap=null;reading='';try{game=M.checkpoint(s,id,width());tops={};seen=[];modal=true;debugOpen=false;modalScrollOnClose=true;last=null;debugName=s.checkpoints?.find(c=>c.id===id)?.label??id;render();save();}catch(e){notify('Checkpoint failed: '+String(e));}};
  document.querySelectorAll<HTMLElement>('[data-target]').forEach(e=>{e.onclick=ev=>{ev.stopPropagation();};e.ondblclick=ev=>{ev.preventDefault();ev.stopPropagation();if(Date.now()>=ignoreDoubleClickUntil&&!e.dataset.target!.startsWith('@'))openItem(e.dataset.target!);};e.onkeydown=ev=>{if(!e.dataset.target!.startsWith('@')&&(ev.key==='Enter'||ev.key===' ')){ev.preventDefault();openItem(e.dataset.target!);}};e.ondragstart=ev=>ev.preventDefault();});
  const board=document.querySelector<HTMLElement>('.board')!;
  // The board now survives renders. Attach pointer/touch ownership exactly once.
  if(boundBoards.has(board))return;boundBoards.add(board);
  const begin=(e:Element|null,x:number,y:number,pointer:number,touch?:number)=>{if(dragging||modal||debugOpen||reading||milestoneOpen)return false;const id=target(e);if(!id)return false;const stationary=id.startsWith('@'),doubleTap=!stationary&&!!lastTap&&lastTap.id===id&&Date.now()-lastTap.time<=DOUBLE_TAP_MS&&Math.hypot(x-lastTap.x,y-lastTap.y)<=DOUBLE_TAP_DISTANCE;dragging={id,el:el(id)!,x,y,moved:false,pointer,touch,stationary,doubleTap};highlight(id);dragging.el.classList.add('pressed');return true;};
  const move=(x:number,y:number)=>{if(!dragging)return;if(dragging.doubleTap){if(Math.hypot(x-dragging.x,y-dragging.y)>=DRAG_THRESHOLD){dragging.tapCancelled=true;dragging.el.classList.remove('pressed');clear();}return;}if(dragging.stationary){if(Math.hypot(x-dragging.x,y-dragging.y)>=DRAG_THRESHOLD){dragging.moved=true;dragging.el.classList.remove('pressed');clear();}return;}lastPointer={x,y};if(!dragging.moved&&Math.hypot(x-dragging.x,y-dragging.y)<DRAG_THRESHOLD)return;if(!dragging.moved){const t=M.token(game.state,dragging.id);if(t&&!s.locationPlan)visit(t.location,[]);}dragging.moved=true;lastTap=null;app.classList.add('is-dragging');const r=board.getBoundingClientRect();dragging.el.style.left=(x-r.left)+'px';dragging.el.style.top=(y-r.top)+'px';dragging.el.classList.add('dragging');highlight(dragging.id);const id=target(document.elementFromPoint(x,y));if(id&&id!==dragging.id){const targetLocation=id.startsWith('@')?game.state.hotspots.find(h=>h.id===id.slice(1))?.location:M.token(game.state,id)?.location;const preview=s.locationPlan&&targetLocation?{...game.state,currentLocation:targetLocation,tokens:game.state.tokens.map(t=>t.id===dragging!.id?{...t,location:targetLocation,hotspot:null}:t)}:game.state;const action=M.dropAction(s,preview,dragging.id,id);if(action.type==='combine'&&M.partners(s,preview,dragging.id).partners.includes(id)){dragging.el.classList.add('will-create');el(id)?.classList.add('will-create');}else if(action.type==='place')el(id)?.classList.add('will-place');}if(edge===null)edge=setTimeout(edgeScroll,16);};
  const edgeScroll=()=>{edge=null;if(!dragging?.moved||!lastPointer)return;const v=document.querySelector<HTMLElement>('.viewport')!,r=v.getBoundingClientRect(),{x,y}=lastPointer;const speed=y<r.top+50?-Math.min(12,(r.top+50-y)/4):y>r.bottom-50?Math.min(12,(y-r.bottom+50)/4):0;if(speed){v.scrollTop+=speed;move(x,y);}if(edge===null)edge=setTimeout(edgeScroll,16);};
  const end=(x:number,y:number)=>{if(!dragging)return;const d=dragging,dropTarget=d.moved?target(document.elementFromPoint(x,y)):undefined;stopDrag();if(d.moved||d.tapCancelled)ignoreDoubleClickUntil=Date.now()+500;if(!d.moved&&Math.hypot(x-d.x,y-d.y)>=DRAG_THRESHOLD){lastTap=null;ignoreDoubleClickUntil=Date.now()+500;resumePresentation();return;}if(d.doubleTap){lastTap=null;if(!d.tapCancelled)openItem(d.id);resumePresentation();return;}if(!d.moved){lastTap=d.stationary?null:{id:d.id,x,y,time:Date.now()};resumePresentation();return;}if(d.stationary){render();resumePresentation();return;}const id=dropTarget;if(id&&id!==d.id){drop(d.id,id);}else{const r=board.getBoundingClientRect(),worldY=y-r.top;const location=[...game.state.locations].sort((a,b)=>(tops[b.id]??0)-(tops[a.id]??0)).find(a=>worldY>=(tops[a.id]??0))?.id??game.state.locations[0].id;if(s.locationPlan)commit({type:'relocate',item:d.id,location,x:x-r.left,y:worldY-(tops[location]??0)});else{visit(location,[d.id]);commit({type:'move',item:d.id,x:x-r.left,y:worldY-(tops[location]??0)});}}};
  const cancel=()=>{lastTap=null;ignoreDoubleClickUntil=Date.now()+500;if(dragging){stopDrag();render();resumePresentation();}};
  board.onpointerdown=e=>{if(dragging||e.button!==0)return;if(begin(e.target as Element,e.clientX,e.clientY,e.pointerId)){board.setPointerCapture?.(e.pointerId);if(!target(e.target as Element)?.startsWith('@'))e.preventDefault();}};
  const ownsPointer=(e:PointerEvent)=>!!dragging&&dragging.touch===undefined&&dragging.pointer===e.pointerId;
  board.onpointermove=e=>{if(ownsPointer(e))move(e.clientX,e.clientY);};board.onpointerup=e=>{if(ownsPointer(e))end(e.clientX,e.clientY);};board.onpointercancel=e=>{if(ownsPointer(e))cancel();};board.onlostpointercapture=e=>{if(ownsPointer(e))cancel();};
  // Pointer Events own modern touch input. Legacy Touch Events are a fallback,
  // not a second gesture stream that may adopt another finger's identifier.
  board.addEventListener('touchstart',e=>{if(typeof PointerEvent!=='undefined')return;if(dragging){e.preventDefault();return;}const t=e.changedTouches[0];if(t&&begin(e.target as Element,t.clientX,t.clientY,-1,t.identifier)&&!target(e.target as Element)?.startsWith('@'))e.preventDefault();},{passive:false});
  board.addEventListener('touchmove',e=>{const t=Array.from(e.touches).find(t=>t.identifier===dragging?.touch);if(t){if(!dragging?.stationary)e.preventDefault();move(t.clientX,t.clientY);}},{passive:false});board.addEventListener('touchend',e=>{const t=Array.from(e.changedTouches).find(t=>t.identifier===dragging?.touch);if(t){e.preventDefault();end(t.clientX,t.clientY);}},{passive:false});board.addEventListener('touchcancel',e=>{if(Array.from(e.changedTouches).some(t=>t.identifier===dragging?.touch))cancel();},{passive:false});
 }
 if(typeof addEventListener==='function'){addEventListener('resize',()=>{lastTap=null;stopDrag();game=M.resizeGame(game,width(),s);render();save();resumePresentation();});addEventListener('blur',()=>{lastTap=null;if(dragging){stopDrag();render();resumePresentation();}});}
 if(typeof window!=='undefined')installSaveLifecycle(autosave,window,document);
 // Loading a completed objective waits for its explicit arrow, exactly like live play.
 // Entry cascades and unseen bridge facts remain model-owned and durable.
 if(M.pendingChapterBridges(s,game).length)modal=true;
 if(M.pendingMilestone(s,game)){missionAfterMilestones=modal;modal=false;render();presentWhenUnblocked(navigationRequest);}
 else render();
 if(s.chapters[game.state.chapter].onAlreadyComplete)save();
 if(!modal)scrollLocation();
}
