import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
/** Exact terminology successor of the published Iron quarry source. Historical
 * manifests remain immutable; a wrong predecessor is never accepted as current. */
const manifest=JSON.parse(readFileSync(new URL('../reviews/location-hotspot-terminology/source-successors.json',import.meta.url),'utf8'));
export function expectedSourceHashAfterLocationHotspot(path:string,parentSha256:string):string {
 const row=manifest.files[path];if(!row)return parentSha256;
 assert.equal(row.beforeSha256,parentSha256,path+': terminology successor requires exact f780 Iron quarry predecessor');return row.afterSha256;
}
