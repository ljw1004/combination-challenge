import {pathToFileURL} from 'node:url';import {writeFileSync,readFileSync} from 'node:fs';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const [base,destination]=process.argv.slice(2);assert.equal(createHash('sha256').update(readFileSync(base+'/experiments/tangible-campaign/integration/source-manifest.json')).digest('hex'),'dacaaa3832d19900f790a9cd5e571bf790a2cf435e2f32f1bb259861008c80b9','exact published baseline required');const {scenarios}=await import(pathToFileURL(base+'/experiments/tangible-campaign/ui/current-scenarios.ts'));const {applyMilestones}=await import(pathToFileURL(base+'/experiments/tangible-campaign/ui/current-campaign.ts'));const M=await import(pathToFileURL(base+'/experiments/tangible-campaign/engine/campaign.ts'));const {acceptedTestRoute}=await import(pathToFileURL(base+'/experiments/tangible-campaign/integration/accepted-current-test-routes.ts'));const {toLegacyScenario,fromLegacyAction}=await import(pathToFileURL(base+'/experiments/tangible-campaign/compatibility/v1.ts'));const sha=x=>createHash('sha256').update(JSON.stringify(x)).digest('hex');const records=[];
