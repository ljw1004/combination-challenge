        "item": "soap",
        "when": "created",
        "title": "Soap",
        "text": "Soap helps people wash away dirt and grease. Beside a washstand, it makes everyday washing more useful."
      },
      {
        "id": "elements-clock",
        "item": "clock",
        "when": "created",
        "title": "Clock",
        "text": "The clock gives a shared, readable time. People can use it to agree on meetings and boat departures."
