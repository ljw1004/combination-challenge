      },
      {
        "id": "plain-divinity-feed-before-letter",
        "item": "feed-before-letter",
        "when": "created",
        "title": "Luther: buy the hungry household supper before an indulgence letter",
        "text": "Luther says a household with one coin and no supper should buy food before an indulgence letter—a grant of relief from penalties for sins already forgiven. Feeding the family and helping poor neighbours come first.",
