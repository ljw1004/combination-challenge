    "milestones": [
      {
        "id": "milestone-critical-edition",
        "item": "critical-edition",
        "when": "created",
        "title": "An edition that shows its doubts",
        "text": "An editor compares manuscripts and shows uncertain readings. Readers can judge the choices instead of receiving an unexplained final version.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-strict-ptolemy-challenged",
        "item": "strict-ptolemy-challenged",
        "when": "created",
        "title": "Strict Ptolemaic Venus is challenged",
        "text": "Ptolemy's standard model keeps Venus on Earth's side of the Sun, so it cannot show nearly full phases. Observing those phases rules out that arrangement, but not every model in which Earth stays still.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-age-still-open",
        "item": "age-still-open",
        "when": "created",
        "title": "Sequence is not duration",
        "text": "Knowing which events came first does not tell us how many years separated them. Rock order and numerical age are different questions.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-branching-descent",
        "item": "branching-descent",
        "when": "created",
        "title": "Resemblance can record shared descent",
        "text": "Similarities among living things can reflect shared ancestry. Their history branches rather than forming a ladder with humans as its required top.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-earth-age-measured",
        "item": "earth-age-measured",
        "when": "created",
        "title": "Earth is about 4.54 billion years old",
        "text": "Earth formed about 4.54 billion years ago. The estimate draws on radioactive dating and evidence from the early solar system, not the order of rock layers alone.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-industrial-lead-footprint",
        "item": "industrial-lead-footprint",
        "when": "created",
        "title": "An analytical nuisance exposes industrial pollution",
        "text": "Lead appears even in laboratory tests without an ancient sample, revealing contamination that interferes with dating. Comparing older and modern environments turns that measurement problem into evidence of industrial lead pollution.",
        "presentation": "explanation"
      },
      {
        "id": "milestone-unfinished-common-world",
        "item": "unfinished-common-world",
        "when": "created",
        "title": "A shared world with obligations still disputed",
        "text": "People can challenge and revise the community's shared rules. They still disagree about how to divide work, provide care and prevent people from being forced into decisions.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-sky-archive",
        "item": "sky-archive",
        "when": "created",
        "title": "A sky archive with its gaps",
        "text": "The archive records what people saw and marks the nights when they could not observe. Missing evidence is not treated as evidence that nothing happened.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-eclipse-pattern",
        "item": "eclipse-pattern",
        "when": "created",
        "title": "Recurring eclipse seasons",
        "text": "Eclipses recur in patterns. Those patterns help predict when to watch, but not every eclipse is visible from every place.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-watch-window",
        "item": "watch-window",
        "when": "created",
        "title": "A watch, not a promised eclipse",
        "text": "The records suggest when an eclipse may occur. Plan a watch, but clouds or your location may prevent you from seeing one.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-portent-and-pattern",
        "item": "portent-and-pattern",
        "when": "created",
        "title": "Prediction alongside portent",
        "text": "People can predict an eclipse and still give it a religious or political meaning. Prediction does not automatically replace those beliefs.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-seasonal-calendar",
        "item": "seasonal-calendar",
        "when": "created",
        "title": "A calendar for fields and stores",
        "text": "A calendar connects the seasons with farming and food storage. It helps people prepare before the next flood or harvest.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-shared-year",
        "item": "shared-year",
        "when": "created",
        "title": "A publicly shared year",
        "text": "Agreed dates let a community organize work and festivals together. People can share a calendar without agreeing about the nature of the universe.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-natural-eclipse",
        "item": "natural-eclipse",
        "when": "created",
        "title": "An eclipse has a natural cause",
        "text": "Earth's shadow explains why the Moon darkens during a lunar eclipse. This connects a repeated observation with a physical cause.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-conditional-cause",
        "item": "conditional-cause",
        "when": "created",
        "title": "An explanation tied to conditions",
        "text": "An explanation should say when it applies. A lunar eclipse requires Earth to block the sunlight that would otherwise reach the Moon.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-debt-objection",
        "item": "debt-objection",
        "when": "created",
        "title": "Repayment can do harm",
        "text": "A proposed rule says justice means returning what you owe. But returning a weapon to someone who may harm others would cause harm. This example shows why repayment alone cannot define justice.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-examined-definition",
        "item": "examined-definition",
        "when": "created",
        "title": "A definition still under examination",
        "text": "The rule that justice means repaying debts fails when returning a weapon could cause harm. Finding that problem gives a reason to keep questioning the definition; it does not yet supply a complete new one.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-examined-life",
        "item": "examined-life",
        "when": "created",
        "title": "The examined life",
        "text": "An examined life means questioning how you live and why. The aim is to judge your choices, not simply accept praise or custom.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cause-and-meaning",
        "item": "cause-and-meaning",
        "when": "created",
        "title": "Cause need not erase meaning",
        "text": "Explaining how an eclipse happens does not settle what it means to a community. This comparison separates a physical cause from a religious or social interpretation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-answerable-claims",
        "item": "answerable-claims",
        "when": "created",
        "title": "Claims answerable to objections",
        "text": "A claim should be open to questions and difficult examples. The standing of the person making it is not enough to settle whether it is right.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-stable-forms",
        "item": "stable-forms",
        "when": "created",
        "title": "Plato: stable Forms",
        "text": "Plato proposes unchanging Forms, such as Beauty itself, to explain what changing examples share. The beautiful things we encounter are imperfect and changeable, unlike the Form he describes.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-form-in-particular",
        "item": "form-in-particular",
        "when": "created",
        "title": "Aristotle: form in the particular",
        "text": "Aristotle places form in the particular thing: what makes this living thing the kind of thing it is. This differs from Plato's separate Forms.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-animal-kinds",
        "item": "animal-kinds",
        "when": "created",
        "title": "Animals compared by structures and activities",
        "text": "Comparing animals' parts and activities gives a basis for grouping them. One shared feature alone may not be enough to establish a group.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-part-and-function",
        "item": "part-and-function",
        "when": "created",
        "title": "An organ understood through the whole animal",
        "text": "Aristotle understands an animal's parts through the organization of the whole animal. An organ is not explained only by listing its material: its role in that living animal also matters.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-four-causes",
        "item": "four-causes",
        "when": "created",
        "title": "Different questions about why",
        "text": "Aristotle distinguishes four kinds of explanation: what something is made of, its form, what produces it, and its purpose. One answer need not replace the others.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-valid-inference",
        "item": "valid-inference",
        "when": "created",
        "title": "A conclusion follows from premises",
        "text": "A valid argument has a conclusion that must follow if its starting claims are true. It still matters whether those claims are actually true.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-valid-not-true",
        "item": "valid-not-true",
        "when": "created",
        "title": "Validity is not truth",
        "text": "An argument can follow the rules of logic and still start from a false claim. Check both the reasoning and its starting claims.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cultivated-virtue",
        "item": "cultivated-virtue",
        "when": "created",
        "title": "Virtue as cultivated judgment",
        "text": "For Aristotle, living well requires habits and practical judgment developed through action. Knowing a rule is not the same as being able to act well.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-turning-attention",
        "item": "turning-attention",
        "when": "created",
        "title": "Education as a turning of attention",
        "text": "In Plato's cave story, a prisoner learns that familiar shadows are not the whole world. Education means reconsidering what he takes for reality, not simply receiving more facts about the shadows.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cynic-sufficiency",
        "item": "cynic-sufficiency",
        "when": "created",
        "title": "Freedom by needing less",
        "text": "Stories about Diogenes contrast his few wants with a ruler's offer of wealth. Needing less can make it harder for a powerful patron to buy someone's loyalty. This ideal does not mean that forced poverty is harmless.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-convention-questioned",
        "item": "convention-questioned",
        "when": "created",
        "title": "Local respectability does not settle a good life",
        "text": "Cities disagree about what counts as respectable. A custom's local popularity therefore cannot, by itself, settle whether it is a good way to live.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-stoic-control",
        "item": "stoic-control",
        "when": "created",
        "title": "Care for the judgment that is yours",
        "text": "Stoic practice focuses effort on judgments and responses rather than things we cannot control. It does not deny the pain of loss or injustice.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cosmopolis",
        "item": "cosmopolis",
        "when": "created",
        "title": "Fellowship beyond one city",
        "text": "Stoic thinkers connect care for one's own judgments with concern for other people who share in reason. Their idea of fellowship can extend beyond the boundaries of a single city.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-release-from-terror",
        "item": "release-from-terror",
        "when": "created",
        "title": "Freedom from the terror of death",
        "text": "Epicurus argues that there is no suffering after death because there is no remaining sensation. The argument offers relief from fear without denying grief or ending disagreement.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-garden-pleasure",
        "item": "garden-pleasure",
        "when": "created",
        "title": "Pleasure in friendship and sufficiency",
        "text": "Epicurus places friendship, security and simple enjoyment at the centre of a good life. Seeking pleasure in this account does not mean endlessly increasing wealth or indulgence.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-suspended-assent",
        "item": "suspended-assent",
        "when": "created",
        "title": "A judgment left suspended",
        "text": "When the available accounts conflict and neither settles the question, a skeptic can withhold agreement. Leaving judgment open is different from proving that both sides are false or that knowledge is impossible.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-deductive-geometry",
        "item": "deductive-geometry",
        "when": "created",
        "title": "A connected geometric proof",
        "text": "A geometric proof connects a conclusion to stated starting points through logical steps. It explains why the conclusion follows.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-spherical-earth",
        "item": "spherical-earth",
        "when": "created",
        "title": "A spherical Earth",
        "text": "A spherical Earth helps explain why observers in different places see different stars and shadows. It joins local observations into one model.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-measurable-earth",
        "item": "measurable-earth",
        "when": "created",
        "title": "An Earth whose size can be investigated",
        "text": "Different stars and shadows at different places support a curved Earth. Adding the measured distance between observing places makes it possible to investigate the size of that whole Earth.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-planetary-archive",
        "item": "planetary-archive",
        "when": "created",
        "title": "An archive of planetary motion",
        "text": "Records collected over generations let astronomers compare planetary movements. Greek astronomy also drew on earlier Babylonian observations.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-ptolemaic-model",
        "item": "ptolemaic-model",
        "when": "created",
        "title": "Ptolemy’s predictive heavens",
        "text": "Ptolemy's Earth-centered model predicts celestial positions using combined circular motions. Its historical value includes what it could predict, not just what later accounts changed.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-model-not-cause",
        "item": "model-not-cause",
        "when": "created",
        "title": "A forecast is not its physical cause",
        "text": "A model of planetary motion may accurately predict where a planet appears. That success does not, by itself, establish every physical cause or assumption in the model.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mechanical-sky",
        "item": "mechanical-sky",
        "when": "created",
        "title": "A sky represented in gears",
        "text": "Gears can represent repeating movements in the sky. A physical model makes those cycles visible without explaining every cause of them.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-textual-variants",
        "item": "textual-variants",
        "when": "created",
        "title": "A text with visible alternatives",
        "text": "Different versions of a text are kept visible for comparison. Their differences become evidence about how the work was copied and changed.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-arabic-logic",
        "item": "arabic-logic",
        "when": "created",
        "title": "Logic in a new scholarly language",
        "text": "Translators carry logical arguments into Arabic while developing terms for their distinctions. The texts become available for new teaching and debate.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-arabic-nature",
        "item": "arabic-nature",
        "when": "created",
        "title": "Natural philosophy in Arabic",
        "text": "Arabic-speaking scholars use, criticize and develop inherited accounts of nature. Translation supports new inquiry rather than simply storing old knowledge.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-ptolemy-questioned",
        "item": "ptolemy-questioned",
        "when": "created",
        "title": "Ptolemy read critically",
        "text": "Arabic-speaking astronomers use new observations to criticize difficulties in Ptolemy's inherited sky model. Learning from an older work can lead to revision rather than unquestioning acceptance.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-positional-reckoning",
        "item": "positional-reckoning",
        "when": "created",
        "title": "Place-value reckoning",
        "text": "Place-value notation gives a practical way to record and work with quantities. This mathematical tradition did not come from a single Greek source.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-algebraic-relations",
        "item": "algebraic-relations",
        "when": "created",
        "title": "Reasoning about an unknown share",
        "text": "Relations between known and unknown quantities can be studied before the unknown value is found. This makes a problem easier to state and reason about.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-contingent-being",
        "item": "contingent-being",
        "when": "created",
        "title": "Avicenna: contingent existence",
        "text": "Avicenna distinguishes what a thing is from whether it exists. A thing that could exist or fail to exist still needs an explanation for why it exists at all.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-necessary-being",
        "item": "necessary-being",
        "when": "created",
        "title": "Avicenna: a necessary source of existence",
        "text": "Avicenna argues that things whose existence depends on something else require a source that does not depend on another. His proposed necessary being answers why dependent things exist at all.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-active-commentary",
        "item": "active-commentary",
        "when": "created",
        "title": "A commentary that changes the question",
        "text": "A commentary becomes new inquiry when it tests and develops the older argument. Receiving a tradition can also change it.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-vision-dispute",
        "item": "vision-dispute",
        "when": "created",
        "title": "Rival accounts of sight",
        "text": "Some theories say sight works through rays leaving the eye, while another account studies light entering it. Comparing the claims turns familiar seeing into a question that observations can test.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-light-into-eye",
        "item": "light-into-eye",
        "when": "created",
        "title": "Sight depends on light entering the eye",
        "text": "Ibn al-Haytham explains sight through light entering the eye. This directs inquiry toward light sources, paths and viewing conditions.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-geometric-optics",
        "item": "geometric-optics",
        "when": "created",
        "title": "Light paths as a geometric account",
        "text": "Drawing light paths helps explain images and sight. Geometry connects the arrangement of objects with where their light arrives.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-inverted-image",
        "item": "inverted-image",
        "when": "created",
        "title": "An inverted image on the screen",
        "text": "Light passing through the small opening forms an upside-down image on the screen. The dark box makes the faint image easier to see.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-ground-lens",
        "item": "ground-lens",
        "when": "created",
        "title": "A convex magnifying lens",
        "text": "The glass has been shaped into a convex lens. Held at a suitable distance, it can make a nearby object appear larger.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-magnified-view",
        "item": "magnified-view",
        "when": "created",
        "title": "A magnified close-up view",
        "text": "The lens bends light so that a nearby object appears larger. The view depends on how the lens and object are positioned.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-seeing-and-judging",
        "item": "seeing-and-judging",
        "when": "created",
        "title": "Seeing includes interpretation",
        "text": "Light entering the eye does not explain every judgment we make about what we see. Distance, size and other features can still be misread.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-latin-aristotle",
        "item": "latin-aristotle",
        "when": "created",
        "title": "Aristotle in Latin",
        "text": "Latin translations make Aristotle's works available in new schools and debates. Readers also encounter different interpretations of those works.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-commentaries-in-dispute",
        "item": "commentaries-in-dispute",
        "when": "created",
        "title": "The commentators disagree",
        "text": "Commentators disagree about what an older argument means and whether it succeeds. There is no single uncontested reading.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-reason-faith-distinction",
        "item": "reason-faith-distinction",
        "when": "created",
        "title": "Reason and faith: distinct questions",
        "text": "Aquinas distinguishes truths investigated by natural reason from truths accepted through revelation. The distinction does not make the two inquiries identical.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-formal-disputation",
        "item": "formal-disputation",
        "when": "created",
        "title": "An objection and an accountable reply",
        "text": "An objection receives a reasoned reply in an organized debate. The format makes disagreement explicit; it does not guarantee agreement.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-real-universal",
        "item": "real-universal",
        "when": "created",
        "title": "A shared nature beyond this instance",
        "text": "A realist account says that separate things share a real common nature. Medieval versions differ from Plato's theory of separately existing Forms.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-nominal-kinds",
        "item": "nominal-kinds",
        "when": "created",
        "title": "Common concepts, not a shared thing outside the mind",
        "text": "A nominalist account uses common names and concepts for separate things without positing a shared universal thing outside the mind. This is more than rejecting Plato's separate Forms.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-universals-open",
        "item": "universals-open",
        "when": "created",
        "title": "One shared name, rival accounts",
        "text": "A realist account says separate things share a real common nature. A nominalist account groups individuals through names and concepts without such a shared thing outside the mind.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-explanatory-economy",
        "item": "explanatory-economy",
        "when": "created",
        "title": "Do not multiply idle explanations",
        "text": "Do not add things to an explanation when they do no work. A shorter explanation is not automatically true; it must still account for the evidence.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-intelligible-nature",
        "item": "intelligible-nature",
        "when": "created",
        "title": "Aquinas: nature has its own intelligibility",
        "text": "For Aquinas, studying natural causes can help people understand a created world. Religious belief need not make every event an unexplained miracle.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-reproducible-page",
        "item": "reproducible-page",
        "when": "created",
        "title": "A reproducible printed page",
        "text": "Printing makes repeated copies of a prepared page possible. Different cultures developed different ways to use that possibility.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-type-printed-edition",
        "item": "type-printed-edition",
        "when": "created",
        "title": "An edition made with reusable type",
        "text": "Reusable type allows an edition to be printed in many copies. It expands circulation without removing the need for editing.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-compared-edition",
        "item": "compared-edition",
        "when": "created",
        "title": "Printed copies with inspectable variants",
        "text": "Printed copies let more readers compare the same text. The editor's uncertain choices still need to be visible.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-parallel-translations",
        "item": "parallel-translations",
        "when": "created",
        "title": "Greek and Latin versions side by side",
        "text": "Greek and Latin versions can be read side by side. Comparing them helps readers question earlier translation choices.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-translation-choices",
        "item": "translation-choices",
        "when": "created",
        "title": "A translation’s choices made visible",
        "text": "A translation involves choices about meaning. Showing those choices lets readers see where another interpretation may be possible.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-ancient-wisdom-claim",
        "item": "ancient-wisdom-claim",
        "when": "created",
        "title": "A claim to a primordial wisdom",
        "text": "Some Renaissance readers connected Plato with writings attributed to Hermes because they believed both offered ancient wisdom. The claimed great age of the Hermetic texts helped give them authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-redated-hermetica",
        "item": "redated-hermetica",
        "when": "created",
        "title": "Hermetic wisdom, later than claimed",
        "text": "Renaissance readers had treated the writings attributed to Hermes as extremely ancient. Evidence from their language places them later. This weakens the appeal to antiquity without automatically refuting every idea they contain.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-contested-publication",
        "item": "contested-publication",
        "when": "created",
        "title": "Printed knowledge under contention",
        "text": "Printing brings knowledge to more readers while also creating new struggles over censorship and authority. Wider circulation is not the same as unrestricted speech.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-printed-euclid",
        "item": "printed-euclid",
        "when": "created",
        "title": "A geometric proof that many readers can compare",
        "text": "A printed geometric proof can reach many readers in comparable copies. They can examine the same reasoning and challenge its steps.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-viewpoint-occlusion",
        "item": "viewpoint-occlusion",
        "when": "created",
        "title": "A fixed view leaves other surfaces hidden",
        "text": "A fixed viewpoint hides some surfaces behind others. What a picture leaves out can change when the viewer moves.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mapped-globe",
        "item": "mapped-globe",
        "when": "created",
        "title": "An Earth with comparable positions",
        "text": "A shared system of positions connects individual places across Earth. It lets observations from different places be compared.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-projection-tradeoff",
        "item": "projection-tradeoff",
        "when": "created",
        "title": "Useful bearings, distorted areas",
        "text": "Flattening Earth involves choices. This chart makes compass directions useful while greatly enlarging areas near the poles.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-telescope",
        "item": "telescope",
        "when": "created",
        "title": "A telescope",
        "text": "The telescope makes distant objects appear larger. It opens new observations, but interpreting them still requires argument and comparison.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-rough-moon",
        "item": "rough-moon",
        "when": "created",
        "title": "An earthly-looking Moon",
        "text": "The Moon's shadows suggest a rough surface. This challenges a strict contrast between perfect heavens and an imperfect Earth.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-jupiter-moons",
        "item": "jupiter-moons",
        "when": "created",
        "title": "A system of moons around Jupiter",
        "text": "The moving points are understood as moons orbiting Jupiter. They show that not everything circles Earth directly, but do not alone prove that Earth moves.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-copernican-world",
        "item": "copernican-world",
        "when": "created",
        "title": "Earth as a moving planet",
        "text": "In Copernicus's model, Earth and the other planets orbit the Sun. Earth is a moving planet, not the stationary centre of the heavens.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-relative-retrograde",
        "item": "relative-retrograde",
        "when": "created",
        "title": "Apparent reversal from relative motion",
        "text": "A planet can appear to move backward because Earth and that planet are both moving. Relative motion explains the appearance without requiring an actual reversal.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-venus-phases",
        "item": "venus-phases",
        "when": "created",
        "title": "The full range of Venus’s phases",
        "text": "Repeated observations reveal Venus's full range of phases. Any successful model must account for both its crescent and nearly full appearances.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-tycho-still-live",
        "item": "tycho-still-live",
        "when": "created",
        "title": "A stationary-Earth alternative remains live",
        "text": "Venus's phases can fit Tycho's model, in which the Sun circles a stationary Earth and the other planets circle the Sun. Those observations alone therefore do not prove that Earth moves.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-kepler-ellipse",
        "item": "kepler-ellipse",
        "when": "created",
        "title": "An elliptical path for Mars",
        "text": "Kepler uses an ellipse rather than a perfect circle to describe Mars's orbit. A different shape fits the inherited observations better.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-revised-harmony",
        "item": "revised-harmony",
        "when": "created",
        "title": "A lawful sky without perfect circles",
        "text": "Kepler replaces the perfect circle with an ellipse for Mars's orbit. Astronomy can still seek lawful order while changing what that order looks like to fit the observations.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-working-natural-history",
        "item": "working-natural-history",
        "when": "created",
        "title": "Natural history includes what crafts can do",
        "text": "Bacon includes workshop practices in the study of nature. Changing materials can reveal things that passive observation misses.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-bias-under-examination",
        "item": "bias-under-examination",
        "when": "created",
        "title": "An inquiry that looks for unwelcome cases",
        "text": "An inquiry deliberately looks for evidence that could challenge its preferred answer. This reduces one source of error without making the investigator free of bias.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-heat-light-conjecture",
        "item": "heat-light-conjecture",
        "when": "created",
        "title": "Heat seems tied to light",
        "text": "Sunlight and flame suggest that heat may be connected with light. Two supporting examples are a starting proposal, not a general proof.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-light-not-sufficient",
        "item": "light-not-sufficient",
        "when": "created",
        "title": "Brightness need not bring comparable felt warmth",
        "text": "A flame gives light and warmth, but bright moonlight gives little noticeable warmth. This comparison challenges a simple link between visible brightness and felt heat; it does not show that moonlight transfers no energy.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-heat-beyond-light",
        "item": "heat-beyond-light",
        "when": "created",
        "title": "Heat must be sought beyond luminous bodies",
        "text": "Rubbing can produce warmth without a glowing source. An account that ties heat only to shining objects therefore misses an ordinary case and must be reconsidered.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-rubbing-intervention",
        "item": "rubbing-intervention",
        "when": "created",
        "title": "Rubbing changes the warming in this comparison",
        "text": "The rubbed wood warms while the untouched comparison does not. Changing one condition helps test whether rubbing causes the difference.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-melancholy-many-sources",
        "item": "melancholy-many-sources",
        "when": "created",
        "title": "Melancholy across bodies, books and experience",
        "text": "Burton studies melancholy through medical traditions, literature and experience. His account combines different kinds of knowledge rather than reducing the subject to one cause.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-public-trial",
        "item": "public-trial",
        "when": "created",
        "title": "A trial another workshop can repeat",
        "text": "Another workshop can inspect the method and repeat the trial. Sharing the procedure makes checking possible, though disputes about trust can remain.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-repeatable-wonder",
        "item": "repeatable-wonder",
        "when": "created",
        "title": "An optical wonder with an inspectable arrangement",
        "text": "Light passing through a small opening forms an upside-down image inside a dark box. Other people can inspect and repeat the setup to check whether it produces the same image.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mechanical-nature",
        "item": "mechanical-nature",
        "when": "created",
        "title": "Nature investigated through matter and motion",
        "text": "Nature is investigated through the movement and arrangement of matter. This approach asks whether physical mechanisms can explain familiar effects.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-clockwork-figure",
        "item": "clockwork-figure",
        "when": "created",
        "title": "A figure moved by a copied gear linkage",
        "text": "The mechanical figure uses linked gears to move. The sky model shows how a linkage can coordinate movement, while the figure provides a new use for that idea.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-imitation-limit",
        "item": "imitation-limit",
        "when": "created",
        "title": "Imitated motion does not establish a living animal",
        "text": "A gear-driven figure can copy an animal's movement. That alone does not show feeding, growth, repair or sensation. Mechanical imitation and a complete explanation of life are different achievements.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-falling-moon",
        "item": "falling-moon",
        "when": "created",
        "title": "An orbit considered as continual falling",
        "text": "An orbit can be understood as continual falling around Earth. This connects motion in the sky with falling near the ground.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-universal-gravitation",
        "item": "universal-gravitation",
        "when": "created",
        "title": "Newton proposes one attraction for Earth and sky",
        "text": "Newton proposes that the same attraction accounts for falling bodies and planetary motion. The proposal connects observations of Earth and sky, rather than proving itself from a wish for harmony.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-white-light-components",
        "item": "white-light-components",
        "when": "created",
        "title": "White light contains differently refracted colours",
        "text": "A selected colour stays the same through a second prism, while reunited colours make white light. Newton uses these comparisons to show that glass separates components of white light rather than simply manufacturing new colours.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-one-way-circulation",
        "item": "one-way-circulation",
        "when": "created",
        "title": "Venous valves direct blood back to the heart",
        "text": "Valves in veins direct blood toward the heart. Their operation supplies evidence for the return part of a circulation account rather than merely assuming that blood circulates.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-blood-circuit",
        "item": "blood-circuit",
        "when": "created",
        "title": "Out through arteries, back through veins",
        "text": "The heart pumps blood out through arteries, and vein valves direct blood back toward the heart. Harvey joins these directions into a circulation account, though he cannot yet see the tiny connections through tissues.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-newtonian-framework",
        "item": "newtonian-framework",
        "when": "created",
        "title": "Universal mechanics in absolute space and time",
        "text": "Newton describes motion on Earth and in the sky in one system. He assumes space exists independently of the objects in it, and time passes alike everywhere. Later theories must explain both the system's successes and its limits.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-time-longitude",
        "item": "time-longitude",
        "when": "created",
        "title": "Longitude from two kinds of time",
        "text": "A difference between local time and reference time gives an east–west position difference. The method depends on a reliable reference.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-sea-tested-clock",
        "item": "sea-tested-clock",
        "when": "created",
        "title": "Sea-tested reference time",
        "text": "The report describes how Harrison's H4 clock kept the time of a known place during a sea voyage. Comparing that reference time with local noon gives longitude: how far east or west the observer is from that place. The successful trial supports the method, but does not certify every clock. Further testing and the reward remained disputed.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-lunar-reference",
        "item": "lunar-reference",
        "when": "created",
        "title": "Reference time read from the Moon",
        "text": "The Moon changes position against the stars as time passes. A navigator can compare its measured position with prepared tables to find the time at a known place.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-lunar-longitude",
        "item": "lunar-longitude",
        "when": "created",
        "title": "A lunar route to longitude",
        "text": "A navigator compares the Moon’s measured position with prepared tables to find the time at a known place. Comparing that time with local time gives the east–west position. This is an alternative to carrying a sea clock, but needs a clear view of the sky.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-jaipur-comparison",
        "item": "jaipur-comparison",
        "when": "created",
        "title": "Astronomical traditions compared at Jaipur",
        "text": "At Jaipur, different astronomical traditions are compared with observations. Inherited tables become material for active revision rather than unquestioned authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-masonry-observatory",
        "item": "masonry-observatory",
        "when": "created",
        "title": "Plan for a masonry observatory",
        "text": "Large fixed instruments are designed for measuring the sky and checking astronomical tables. Their scale and stable sightlines serve that work.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-encyclopedic-craft",
        "item": "encyclopedic-craft",
        "when": "created",
        "title": "Craft enters the public account of knowledge",
        "text": "Craft knowledge is included in a widely shared reference work. Practical making becomes part of learned knowledge despite censorship and disagreement.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-encyclopedic-network",
        "item": "encyclopedic-network",
        "when": "created",
        "title": "Knowledge joined by cross-reference",
        "text": "Cross-references let readers connect different subjects and practices. The structure supports more than one route through knowledge.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-problem-of-induction",
        "item": "problem-of-induction",
        "when": "created",
        "title": "Past success does not guarantee the next case",
        "text": "A pattern that held in past observations is not logically guaranteed to hold in the next case. Hume asks what justifies making that further prediction.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-conditions-of-experience",
        "item": "conditions-of-experience",
        "when": "created",
        "title": "Kant: the mind helps structure experience",
        "text": "Hume questions what justifies extending observed patterns beyond the cases already seen. Kant responds by asking what the mind contributes to make experience possible. His account is a philosophical response, not one experiment that settles the dispute.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-sufficiency-against-status",
        "item": "sufficiency-against-status",
        "when": "created",
        "title": "Enough is not the same as higher status",
        "text": "Social standing can demand more and more possessions. The older ideal of friendship and having enough challenges that demand: a higher status is not the same thing as a better life.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-universal-rights",
        "item": "universal-rights",
        "when": "created",
        "title": "A claim to rights beyond inherited rank",
        "text": "Rights are claimed for people beyond inherited rank or privilege. Whether the claim is truly universal depends on whom law and practice include.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-rights-for-women",
        "item": "rights-for-women",
        "when": "created",
        "title": "Universal reason must include women",
        "text": "A declaration may invoke universal reason while women are denied the education used to develop it. Wollstonecraft turns that stated principle against the exclusion and unequal treatment of women.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-rights-against-slavery",
        "item": "rights-against-slavery",
        "when": "created",
        "title": "Universal liberty confronts enslavement",
        "text": "A claim of universal liberty conflicts with enslavement. The testimony and actions of enslaved people expose that conflict, rather than leaving it as an abstract puzzle.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-public-reasoning",
        "item": "public-reasoning",
        "when": "created",
        "title": "An argument answerable to a wider public",
        "text": "Arguments are opened to criticism from a wider public. Broader discussion can challenge authority without guaranteeing equal participation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-private-vice-public-benefit",
        "item": "private-vice-public-benefit",
        "when": "created",
        "title": "Mandeville: private vice, public benefit",
        "text": "Mandeville argues that private motives condemned as vices can support public prosperity. The uncomfortable question is whether wealth created by such motives makes a society good.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-division-of-labour",
        "item": "division-of-labour",
        "when": "created",
        "title": "Production divided into specialized tasks",
        "text": "Work is divided into specialized tasks, allowing more to be produced. Organization, not only machinery, can change a workshop's output.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-specialization-cost",
        "item": "specialization-cost",
        "when": "created",
        "title": "More output can narrow the maker’s life",
        "text": "Specialized work may increase output while narrowing the worker's abilities and daily life. Greater efficiency is not the same as greater well-being.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-prosperity-not-good-life",
        "item": "prosperity-not-good-life",
        "when": "created",
        "title": "Prosperity and a good life can diverge",
        "text": "More trade and wealth do not automatically provide friendship, security or worthwhile activity. Comparing economic prosperity with the older ideal of a sufficient life keeps those different measures of success visible.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-population-pressure",
        "item": "population-pressure",
        "when": "created",
        "title": "More offspring than available subsistence",
        "text": "Malthus argues that potential population growth can exceed growth in food supplies. This can create pressure, but it does not decide which response is fair.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-scarcity-and-justice",
        "item": "scarcity-and-justice",
        "when": "created",
        "title": "Scarcity does not settle who should bear it",
        "text": "A shortage describes a problem; it does not decide who should bear its costs. A policy still needs a separate justification.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-long-distance-exchange",
        "item": "long-distance-exchange",
        "when": "created",
        "title": "An enlarged world of exchange",
        "text": "Navigation and preserved food allow exchange over longer distances. Goods can travel farther because voyages can be located and sustained.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-coercive-exchange",
        "item": "coercive-exchange",
        "when": "created",
        "title": "Exchange entangled with coercion",
        "text": "Long-distance exchange can depend on forced labour and political power. Technical improvements alone do not explain who benefits or who suffers.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-work-as-a-human-question",
        "item": "work-as-a-human-question",
        "when": "created",
        "title": "The maker is more than the output",
        "text": "Workers are people whose abilities and lives matter, not only sources of output. A productive arrangement can still fail them.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-organic-fossil",
        "item": "organic-fossil",
        "when": "created",
        "title": "A fossil is a trace of former life",
        "text": "The object is understood as a trace of former life. Comparing it with living organisms turns it into evidence about the past.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-relative-strata",
        "item": "relative-strata",
        "when": "created",
        "title": "A sequence of deposited worlds",
        "text": "Rock layers can be placed in order from earlier to later. This establishes a sequence without yet giving ages in years.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-correlated-strata",
        "item": "correlated-strata",
        "when": "created",
        "title": "Separated beds, a comparable succession",
        "text": "Matching fossil sequences connects separated rock layers. A history can be reconstructed across more than one exposed cliff.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-process-history",
        "item": "process-history",
        "when": "created",
        "title": "Present processes can explain ancient traces",
        "text": "Streams erode rock and deposit sediment today. Those observed processes help explain similar traces preserved in ancient rock.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cycles-in-rock",
        "item": "cycles-in-rock",
        "when": "created",
        "title": "More than one making of the landscape",
        "text": "Tilted rock layers beneath younger level layers require several episodes: deposition, tilting, erosion and new deposition. The landscape records repeated change rather than one unchanged act of formation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-deep-time-world",
        "item": "deep-time-world",
        "when": "created",
        "title": "A landscape needs a deep past",
        "text": "Many layers and repeated changes require a long history. The evidence establishes an extended past without yet measuring exactly how many years it lasted.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-extinction-real",
        "item": "extinction-real",
        "when": "created",
        "title": "Whole forms of life have disappeared",
        "text": "Some kinds of animals no longer exist. A catalogue of life must therefore include a past that differs from the present.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-eventful-geology",
        "item": "eventful-geology",
        "when": "created",
        "title": "Long processes and abrupt events",
        "text": "Earth's history includes long-running processes and abrupt events. It need not be reduced to either constant slow change or one worldwide catastrophe.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-named-species",
        "item": "named-species",
        "when": "created",
        "title": "Comparable names for living kinds",
        "text": "Shared two-part names make records of species easier to compare. The names help investigation without making the groups beyond revision.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-geography-of-life",
        "item": "geography-of-life",
        "when": "created",
        "title": "Life patterned by place and conditions",
        "text": "Living things vary with place, climate and altitude. Comparing these patterns connects classification with the conditions of life.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-transforming-species",
        "item": "transforming-species",
        "when": "created",
        "title": "Species can have changing histories",
        "text": "Lamarck argues that use and disuse change an organism's body, and those changes can pass to its offspring. This differs from natural selection, which acts on inherited differences already present.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-selection-analogy",
        "item": "selection-analogy",
        "when": "created",
        "title": "Small inherited differences can accumulate",
        "text": "Breeding shows how small inherited differences can accumulate. Natural selection uses the comparison without requiring a breeder who plans nature's changes.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-struggle-for-existence",
        "item": "struggle-for-existence",
        "when": "created",
        "title": "Heritably varied offspring face limited resources",
        "text": "Offspring have inherited differences and face limited resources. These facts alone do not show which differences will leave more descendants; reproductive outcomes must also be compared.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-natural-selection",
        "item": "natural-selection",
        "when": "created",
        "title": "Unequal reproduction changes a population",
        "text": "Inherited differences that affect reproduction can become more or less common over generations. Natural selection describes this population change, not a rule that the strongest always win.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cumulative-evolution",
        "item": "cumulative-evolution",
        "when": "created",
        "title": "Selection can reshape life across deep time",
        "text": "Small inherited changes can accumulate across many generations. Deep geological time gives that process a scale far beyond a human lifetime.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-changed-meaning-of-kinds",
        "item": "changed-meaning-of-kinds",
        "when": "created",
        "title": "Changing species, different accounts of how",
        "text": "Lamarck explains species change through bodily changes acquired during life and passed to offspring. Darwin and Wallace's account of natural selection instead concerns inherited differences that affect survival and reproduction. They agree that species change, but differ about how.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-open-heredity",
        "item": "open-heredity",
        "when": "created",
        "title": "Cumulative evolution with heredity still unresolved",
        "text": "Evolutionary change requires inherited differences to persist across generations. How that happened remained unresolved in these nineteenth-century arguments.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-industrial-production",
        "item": "industrial-production",
        "when": "created",
        "title": "Specialized labour at machine scale",
        "text": "Powered machinery and specialized tasks increase the scale of production. The factory combines a technology with a way of organizing people.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-fuel-dependent-industry",
        "item": "fuel-dependent-industry",
        "when": "created",
        "title": "Industrial power has a material appetite",
        "text": "Industrial output depends on a continuing fuel supply. Its apparent power has material costs and consequences.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-alienated-work",
        "item": "alienated-work",
        "when": "created",
        "title": "The maker can lose control of the work",
        "text": "In Marx's critique, workers can lose control over their activity and its products. The problem is a relationship of ownership and power, not simply disliking a task.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-useful-pleasurable-work",
        "item": "useful-pleasurable-work",
        "when": "created",
        "title": "Useful work need not erase the maker",
        "text": "Morris proposes work that produces useful things while giving the maker worthwhile activity. It is an alternative to assess, not a completed solution to economic organization.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cooperation-in-evolution",
        "item": "cooperation-in-evolution",
        "when": "created",
        "title": "Mutual aid belongs inside the question of survival",
        "text": "Cooperation can help organisms survive and reproduce. Recognizing its importance does not refute natural selection.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-competitive-story-limited",
        "item": "competitive-story-limited",
        "when": "created",
        "title": "Nature is not a competition-only morality tale",
        "text": "Nature includes cooperation as well as competition. Neither fact by itself tells people how a society ought to be governed.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-control-of-work",
        "item": "control-of-work",
        "when": "created",
        "title": "Mechanized effort can deepen lost control",
        "text": "A labour-saving machine may still leave workers with less say over their pace and decisions. Reduced effort and greater control are separate gains.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-microscopic-life",
        "item": "microscopic-life",
        "when": "created",
        "title": "A previously unseen living world",
        "text": "The microscope reveals living things too small for unaided sight. Discovering them expands knowledge without automatically explaining which ones cause illness.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-waterborne-pattern",
        "item": "waterborne-pattern",
        "when": "created",
        "title": "Cholera mortality tracks a water-supply difference",
        "text": "Cholera deaths differ between comparable households using different water supplies. This supports investigating water as a cause while still checking other differences and the quality of records.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-prevention-before-settlement",
        "item": "prevention-before-settlement",
        "when": "created",
        "title": "A useful intervention before full agreement",
        "text": "The cholera comparison points toward contaminated water as a preventable route of disease. Avoiding that water can be justified before everyone agrees about the complete microscopic cause.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-competing-disease-accounts",
        "item": "competing-disease-accounts",
        "when": "created",
        "title": "Foul air or a waterborne cause?",
        "text": "One account blames cholera on foul air; another connects it with contaminated water. Comparing the water-supply evidence challenges the rival explanations without pretending they have equal support.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-microbial-growth",
        "item": "microbial-growth",
        "when": "created",
        "title": "Broth growth tracks incoming microorganisms",
        "text": "Air reaches both broths, but dust reaches only one, and only that broth develops growth. The comparison supports microorganisms arriving with dust rather than air alone producing life.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-living-fermentation",
        "item": "living-fermentation",
        "when": "created",
        "title": "Organisms participate in chemical change",
        "text": "Living cultures participate in changes such as fermentation. Biological activity becomes part of the explanation of material transformation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-chemical-agency-in-cells",
        "item": "chemical-agency-in-cells",
        "when": "created",
        "title": "Living activity includes separable chemistry",
        "text": "Yeast extract ferments even without intact yeast cells. Buchner's later result shows that some of the chemistry can operate outside a whole living cell, revising the earlier claim without erasing microorganisms' role.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-electromagnetic-link",
        "item": "electromagnetic-link",
        "when": "created",
        "title": "Electricity acts magnetically",
        "text": "An electric current makes a nearby compass needle turn. This shows that electricity can have a magnetic effect without a visible mechanical push.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-induction",
        "item": "induction",
        "when": "created",
        "title": "A changing field can produce a current",
        "text": "Changing a magnetic field can produce a current. The effect provides a way to generate electrical action.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-field-description",
        "item": "field-description",
        "when": "created",
        "title": "The surrounding space becomes part of the account",
        "text": "A field describes how physical influence varies throughout space. The surroundings become part of the explanation, not just empty distance between objects.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-electromagnetic-light",
        "item": "electromagnetic-light",
        "when": "created",
        "title": "Light belongs to the electromagnetic field",
        "text": "The linked electrical and magnetic account predicts waves travelling at light's speed. Light becomes part of the same physical theory.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-networked-time",
        "item": "networked-time",
        "when": "created",
        "title": "Clock coordination travels over a network",
        "text": "A reference time can be sent by electrical signals to distant clocks. People no longer have to rely only on carrying a clock between places.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-standard-time",
        "item": "standard-time",
        "when": "created",
        "title": "A shared railway time",
        "text": "Railway stations adopt a shared time so that timetables agree. That practical standard differs from each place's own solar time.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-photographic-trace",
        "item": "photographic-trace",
        "when": "created",
        "title": "Light leaves a lasting image",
        "text": "Light produces a lasting image on a prepared surface. The image records an exposure, but still requires choices about the setup and interpretation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-framed-photograph",
        "item": "framed-photograph",
        "when": "created",
        "title": "A photograph records from a selected viewpoint",
        "text": "A photograph records the view chosen by the photographer. Its physical connection to the scene does not make everything outside the frame visible.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-reproducible-image",
        "item": "reproducible-image",
        "when": "created",
        "title": "The image can circulate in many copies",
        "text": "Many prints can be made from one negative. Wider circulation changes who can see the image without making its framing neutral.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-inner-continuity",
        "item": "inner-continuity",
        "when": "created",
        "title": "Experience has a moving continuity",
        "text": "William James describes experience as a changing but connected flow. Attention shifts while earlier thoughts continue to shape the next moment.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-lived-duration",
        "item": "lived-duration",
        "when": "created",
        "title": "Lived time is not a row of clock units",
        "text": "An experience has qualities and continuity that a sequence of clock readings does not describe. This does not make clocks useless or inaccurate.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-interpreted-dream",
        "item": "interpreted-dream",
        "when": "created",
        "title": "A dream can be read for concealed conflict",
        "text": "Freud's approach reads a dream for hidden wishes and conflicts. It is an interpretive proposal, not the same kind of result as a physical measurement.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-automatic-writing",
        "item": "automatic-writing",
        "when": "created",
        "title": "Writing without the usual planned control",
        "text": "The writer loosens ordinary planning to follow words and associations. Surrealists use this as an artistic experiment, not a verified diagnosis.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-surreal-encounter",
        "item": "surreal-encounter",
        "when": "created",
        "title": "The familiar becomes strangely connected",
        "text": "An unexpected combination makes familiar things seem strange. The artwork asks the viewer to reconsider ordinary associations and expectations.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-art-beyond-illustration",
        "item": "art-beyond-illustration",
        "when": "created",
        "title": "An artwork can challenge ordinary life",
        "text": "An artwork can raise questions about ordinary life and society. It need not merely illustrate an already finished theory.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-plural-access-to-time",
        "item": "plural-access-to-time",
        "when": "created",
        "title": "Measured coordination and lived duration",
        "text": "Railway clocks coordinate public events, while descriptions of lived time address memory and experience. These answer different questions; a remembered melody does not refute a working clock.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-frame-dependent-simultaneity",
        "item": "frame-dependent-simultaneity",
        "when": "created",
        "title": "Different frames need not agree on distant simultaneity",
        "text": "Two flashes happen at a moving train's ends at the same time according to platform clocks, but their light reaches a passenger at the train's midpoint at different times. For the passenger, light travels equal distances from the two ends at the same speed. The passenger therefore concludes that the flashes happened at different times.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-special-relativity",
        "item": "special-relativity",
        "when": "created",
        "title": "No preferred inertial frame or universal distant present",
        "text": "Observers moving steadily past one another use the same physical laws and measure the same speed of light. They can still disagree about whether far-apart events happened at the same time. Newton's mechanics remains a useful approximation at everyday speeds.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-newtonian-limit",
        "item": "newtonian-limit",
        "when": "created",
        "title": "Newton’s shared time is a useful limit, not universal",
        "text": "Newton treats time as passing the same way for everyone. Relativity says moving observers can disagree about whether distant events happen at the same time. Newton's account still works well at everyday speeds.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-local-equivalence",
        "item": "local-equivalence",
        "when": "created",
        "title": "Free fall connects gravity and acceleration",
        "text": "A person in a freely falling room can locally feel weightless. Einstein uses the relation between gravity and acceleration to motivate a new account; this does not make gravitational differences vanish everywhere.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-geometric-gravity",
        "item": "geometric-gravity",
        "when": "created",
        "title": "Gravity changes the geometry of paths",
        "text": "In Einstein's account, matter and the geometry of space and time affect the paths bodies follow. Gravity is no longer described only as a force acting across fixed space.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-tested-light-bending",
        "item": "tested-light-bending",
        "when": "created",
        "title": "A new geometry meets a light observation",
        "text": "Einstein's gravitational theory predicts a change in the path of light near the Sun. Eclipse observations test that consequence, with measurement uncertainty and interpretation still part of the evidence.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-reassembled-continents",
        "item": "reassembled-continents",
        "when": "created",
        "title": "Continents can be compared in an earlier arrangement",
        "text": "Continents can be placed in a proposed earlier arrangement and compared. The reconstruction must fit evidence, not just look like a puzzle.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-continental-drift-case",
        "item": "continental-drift-case",
        "when": "created",
        "title": "Separated lands share a geological past",
        "text": "Matching fossils and rock formations strengthen the case that separated continents share a past. Several kinds of evidence matter more than an outline resemblance alone.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-drift-without-drive",
        "item": "drift-without-drive",
        "when": "created",
        "title": "A strong pattern, an unresolved driving account",
        "text": "Matching fossils and rocks suggest that continents once joined have moved apart, but Wegener did not have a convincing account of the force moving them. Evidence that they moved can be stronger than the current explanation of how.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mineral-clock",
        "item": "mineral-clock",
        "when": "created",
        "title": "A rock can contain a measurable clock",
        "text": "Radioactive decay can turn a mineral into a measure of elapsed time. Interpreting it requires checking whether later events changed the material.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-absolute-age-possible",
        "item": "absolute-age-possible",
        "when": "created",
        "title": "The sequence can acquire durations",
        "text": "Rock layers give an order of events, but radioactive decay supplies a measure of elapsed time. Mineral evidence can now address how many years passed, provided its later history is understood.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-seafloor-spreading",
        "item": "seafloor-spreading",
        "when": "created",
        "title": "Ocean floor is made and moves away from ridges",
        "text": "New ocean floor forms at ridges and spreads out on both sides. As its rock cools, it records Earth's magnetic direction. Matching bands on opposite sides of a ridge show that the floor has moved outward.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mobile-plates",
        "item": "mobile-plates",
        "when": "created",
        "title": "Continents move with plates of rigid outer Earth",
        "text": "Continents move as parts of rigid plates made of crust and the uppermost mantle. Plate tectonics is not simply Wegener's original mechanism declared correct.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-recycled-crust",
        "item": "recycled-crust",
        "when": "created",
        "title": "Plates form, move and descend",
        "text": "Plates form, move and descend at different boundaries. These processes fit together without requiring Earth to grow steadily larger.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-relocated-habitats",
        "item": "relocated-habitats",
        "when": "created",
        "title": "Life’s changing map includes moving land",
        "text": "Continents move as parts of plates, changing the locations and connections of habitats. Patterns of living things must therefore be explained on a changing surface rather than a fixed map.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-boolean-logic",
        "item": "boolean-logic",
        "when": "created",
        "title": "Inference becomes a manipulable symbolic system",
        "text": "Logical relationships can be represented and manipulated with symbols. The form of an argument becomes something that can be worked on systematically.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-logic-circuit",
        "item": "logic-circuit",
        "when": "created",
        "title": "Logical operations become switching actions",
        "text": "A circuit carries out logical operations through switching. Correct operation does not prove that the information supplied to it is true.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-mechanical-procedure",
        "item": "mechanical-procedure",
        "when": "created",
        "title": "A rule-governed symbol machine",
        "text": "A symbol machine follows explicit rules for reading, writing and moving through its work. The procedure can be described separately from the particular machine that carries it out.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-universal-computation",
        "item": "universal-computation",
        "when": "created",
        "title": "One machine can follow many encoded procedures",
        "text": "One machine can follow many procedures when their instructions are encoded as data. It is not limited to one permanently built-in task.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-computation-limit",
        "item": "computation-limit",
        "when": "created",
        "title": "No procedure solves every halting case",
        "text": "No program can always work out whether any other program will eventually stop or run forever. This limits one universal test, not the usefulness of programs in general.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-communication-problem",
        "item": "communication-problem",
        "when": "created",
        "title": "A transmitted message can lose distinctions",
        "text": "A transmitted signal can lose distinctions needed to recover the message. Communication design must protect those distinctions, not just send something detectable.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-error-correcting-message",
        "item": "error-correcting-message",
        "when": "created",
        "title": "A message designed to recover from specified errors",
        "text": "The message includes enough structured extra information to recover from the specified error patterns. It cannot repair every possible corruption or prove that the message is true.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-feedback-control",
        "item": "feedback-control",
        "when": "created",
        "title": "A machine responds to its measured effects",
        "text": "The machine uses measurements of its effects to adjust what it does. Responding to feedback does not by itself establish understanding or unlimited authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-word-identical-page",
        "item": "word-identical-page",
        "when": "created",
        "title": "The collation finds the same words",
        "text": "In Borges's imagined case, comparing the later page with Cervantes confirms that every word matches. That settles the wording while leaving questions about authorship and interpretation open.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-another-work",
        "item": "another-work",
        "when": "created",
        "title": "The same words can become another work",
        "text": "In Borges's imagined case, identical words acquire a different meaning through a later author and context. This does not mean every interpretation is equally well supported.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-useless-total-map",
        "item": "useless-total-map",
        "when": "created",
        "title": "More detail can destroy a map’s usefulness",
        "text": "A map that reproduces everything at full size loses the usefulness of selection. More detail is not always a better guide.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-branching-fiction",
        "item": "branching-fiction",
        "when": "created",
        "title": "A narrative can keep incompatible paths open",
        "text": "A story can keep incompatible paths open instead of selecting one ending. Its branching resembles a diagram of ancestry without being the same kind of explanation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-fictional-archive",
        "item": "fictional-archive",
        "when": "created",
        "title": "The apparatus of scholarship becomes fiction",
        "text": "A work of fiction can imitate editions, notes and references. Scholarly appearance alone is not enough to authenticate a claim.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-aura-and-reproduction",
        "item": "aura-and-reproduction",
        "when": "created",
        "title": "A copy changes the encounter with a work",
        "text": "A copy changes how and where a work is encountered. Reproduction raises questions about presence, tradition and access beyond the technical ability to make copies.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-politics-of-the-copy",
        "item": "politics-of-the-copy",
        "when": "created",
        "title": "Reproduction changes art’s political reach",
        "text": "Reproduction can extend art's audience and alter its political uses. Those changes cannot all be reduced to either liberation or decline.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-genealogy-of-values",
        "item": "genealogy-of-values",
        "when": "created",
        "title": "A moral vocabulary has a contested history",
        "text": "Moral language has a history shaped by conflict and power. Investigating that history raises questions without automatically deciding whether a value is justified.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-relational-categories",
        "item": "relational-categories",
        "when": "created",
        "title": "A category gets meaning from a pattern of relations",
        "text": "A category gains meaning through its relations to other categories. A shared name alone does not explain its role in a social system.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-knowledge-and-discipline",
        "item": "knowledge-and-discipline",
        "when": "created",
        "title": "A classification can help organize conduct",
        "text": "Classifications can be used to guide, train or control people. The effect depends on specific institutions and practices, not knowledge in the abstract.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-false-natural-hierarchy",
        "item": "false-natural-hierarchy",
        "when": "created",
        "title": "A classification can naturalize domination",
        "text": "Racial classifications can present domination as a natural order. Exposing that error does not make all biological naming and comparison useless.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-unequal-universalism",
        "item": "unequal-universalism",
        "when": "created",
        "title": "A universal promise can coexist with exclusion",
        "text": "An account can claim to include all people while excluding women or ranking racial groups as inferior. Comparing these cases exposes a gap between universal claims and practice without treating their histories as interchangeable.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-unstable-distinction",
        "item": "unstable-distinction",
        "when": "created",
        "title": "The original/copy hierarchy unsettles its own case",
        "text": "An imagined critic says only originals create meaning, yet praises a word-identical later page as new. The critic's own example grants a copy the creative role the argument denies it. This identifies a particular tension, not a flaw in every text.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-situated-evidence",
        "item": "situated-evidence",
        "when": "created",
        "title": "A view can be partial without being arbitrary",
        "text": "Evidence comes from particular positions and practices, so every view has limits. A limited view can still be constrained by what is actually there.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-accountable-perspectives",
        "item": "accountable-perspectives",
        "when": "created",
        "title": "Partial perspectives can still answer to evidence",
        "text": "Different viewpoints can be compared with evidence and corrected. Recognizing partial knowledge does not require treating all claims as equally good.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-particulate-heredity",
        "item": "particulate-heredity",
        "when": "created",
        "title": "Inheritance need not blend differences away",
        "text": "Distinct inherited factors can persist across generations rather than blending away. This gives an answer to the older difficulty of how variation can survive long enough for selection to act.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-molecular-heredity",
        "item": "molecular-heredity",
        "when": "created",
        "title": "The inherited difference has a molecular carrier",
        "text": "DNA provides a physical carrier for inherited differences. A molecular mechanism adds detail without explaining every trait on its own.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-genes-in-context",
        "item": "genes-in-context",
        "when": "created",
        "title": "Inherited information acts in a developing world",
        "text": "Inherited information works through development and environmental conditions. Understanding an organism requires more than reading its genes alone.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-ecosystem-relations",
        "item": "ecosystem-relations",
        "when": "created",
        "title": "A habitat is a network of living relations",
        "text": "A habitat is a network of interacting organisms. Where they live matters together with how they feed, compete and cooperate.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-carbon-energy-link",
        "item": "carbon-energy-link",
        "when": "created",
        "title": "Industrial power changes the atmospheric store",
        "text": "Fossil-fuel energy transfers long-stored carbon into the atmosphere. Industrial power therefore changes a planetary store of material.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-radiative-warming",
        "item": "radiative-warming",
        "when": "created",
        "title": "Added greenhouse gas changes Earth’s heat loss",
        "text": "Earth's surface gives off heat as infrared radiation. Greenhouse gases absorb and re-emit some of it, reducing the heat escaping directly to space. The surface and lower atmosphere warm until outgoing heat again balances incoming sunlight.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-climate-pressure",
        "item": "climate-pressure",
        "when": "created",
        "title": "The energy system creates a warming pressure",
        "text": "Fossil-fuel emissions and greenhouse physics together explain a warming influence. The explanation is more than a correlation between two rising records.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-atmospheric-history",
        "item": "atmospheric-history",
        "when": "created",
        "title": "The air has a readable history",
        "text": "Bubbles in dated ice preserve samples of past air. Comparing them over time gives a history of atmospheric composition, unlike a sample whose age is unknown.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-human-driven-warming",
        "item": "human-driven-warming",
        "when": "created",
        "title": "Human activity drives the recent warming",
        "text": "Human activity drives recent global warming through greenhouse emissions and other influences. Uncertainty about some details does not erase the physical mechanism or the wider evidence.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-clean-measurement-problem",
        "item": "clean-measurement-problem",
        "when": "created",
        "title": "The laboratory can contaminate an ancient clock",
        "text": "Modern lead contamination can distort measurements intended to date ancient material. The sample's own lead must be separated from what the laboratory adds.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-world-history-not-destiny",
        "item": "world-history-not-destiny",
        "when": "created",
        "title": "Geography constrains history without writing it alone",
        "text": "Geography and ecology affect what societies can do, but do not determine every event. Institutions, forced labour, individual choices and unexpected events also shape history.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-predictive-assistant",
        "item": "predictive-assistant",
        "when": "created",
        "title": "A powerful predictor, not a universal oracle",
        "text": "The imagined model is useful at finding patterns but is not an all-purpose source of truth. Its errors and limits remain part of the design.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-trial-design-partner",
        "item": "trial-design-partner",
        "when": "created",
        "title": "A model proposes an experiment that people can inspect",
        "text": "The model proposes a test with a method people can inspect. A useful suggestion must expose what changes, what is measured and how it can be checked.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-provenance-rich-observatory",
        "item": "provenance-rich-observatory",
        "when": "created",
        "title": "A record whose making can be examined",
        "text": "The observatory keeps records of how each finding was made. Inspectable evidence matters more than a polished appearance of authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-uncertainty-bearing-model",
        "item": "uncertainty-bearing-model",
        "when": "created",
        "title": "A prediction keeps its unfamiliar case visible",
        "text": "In the imagined observatory, a new case differs from the examples used to train the model. The prediction keeps that unfamiliarity visible instead of hiding it behind confident language.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-cross-checked-discovery",
        "item": "cross-checked-discovery",
        "when": "created",
        "title": "A fictional candidate survives distinct checks",
        "text": "Differently designed instruments detect the same candidate event and pass local checks. Their agreement strengthens the finding, but shared errors or disturbances may still explain it.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-remote-observation-agent",
        "item": "remote-observation-agent",
        "when": "created",
        "title": "A local observer can act while Earth is silent",
        "text": "The observatory can adjust its observations while waiting for Earth. Feedback supports a limited local role, not unlimited machine authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-bounded-autonomy",
        "item": "bounded-autonomy",
        "when": "created",
        "title": "Useful local action with a defined stopping boundary",
        "text": "The system can act locally within an agreed boundary and stop for review beyond it. Responsiveness and oversight are both built into its role.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-automation-with-agency",
        "item": "automation-with-agency",
        "when": "created",
        "title": "A workshop design reserves decisions for its makers",
        "text": "The workshop combines machinery with specific rights to choose tasks and stop unsafe work. Community ownership alone would not guarantee those powers.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-workshop-for-living",
        "item": "workshop-for-living",
        "when": "created",
        "title": "A workshop can value skill as well as output",
        "text": "The workshop values skill and the maker's experience as well as output. Its design does not promise that every necessary task becomes enjoyable.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-care-still-needed",
        "item": "care-still-needed",
        "when": "created",
        "title": "Pleasurable making does not eliminate care burdens",
        "text": "The imagined workshop offers skill and pleasure in making, but care and maintenance remain demanding. A good-life proposal still has to decide how necessary work is supported and shared.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-responsive-city",
        "item": "responsive-city",
        "when": "created",
        "title": "A city can respond locally to urgent signals",
        "text": "The imagined city uses local signals to respond to urgent problems. Unlike a remote observatory, its choices directly involve conflicting human priorities.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-control-tradeoff",
        "item": "control-tradeoff",
        "when": "created",
        "title": "Faster response can reduce time to challenge it",
        "text": "An imagined city controller can react quickly to danger, but affected residents may disagree with its priorities. Faster action leaves less time for challenge before the consequences occur.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-contestable-control",
        "item": "contestable-control",
        "when": "created",
        "title": "Rapid action has an inspectable appeal path",
        "text": "The imagined city gives residents a way to inspect and appeal rapid decisions. This adds accountability, but cannot undo every harm or recover the time lost before an appeal is heard.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-revisable-commons",
        "item": "revisable-commons",
        "when": "created",
        "title": "Cooperation receives rules people can revise",
        "text": "Cooperation is supported by rules that affected people can change. Willingness to cooperate alone does not design a workable institution.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-plural-good-lives",
        "item": "plural-good-lives",
        "when": "created",
        "title": "A prosperous city need not prescribe one good life",
        "text": "A prosperous city need not require everyone to pursue the same life. Wealth is one consideration, not a complete definition of living well.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-common-good",
        "item": "civ-common-good",
        "when": "created",
        "title": "Political life judged by a common good",
        "text": "Political life can be judged by what it enables people to share and achieve. Asking about a common good also raises the question of who is included.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-rule-benefit",
        "item": "civ-rule-benefit",
        "when": "created",
        "title": "Judge rulers by whose interests they serve",
        "text": "A government is judged by whose interests it serves, not only by how many people rule. A ruler's benefit can differ from the community's.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-citizen-boundary",
        "item": "civ-citizen-boundary",
        "when": "created",
        "title": "Living in a city does not grant a political voice",
        "text": "Living in a city does not necessarily give a person a political voice. Ancient citizenship excluded many people on whom the city depended.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-bounded-common-good",
        "item": "civ-bounded-common-good",
        "when": "created",
        "title": "Who is included in the common good?",
        "text": "A city can claim to serve a common good while denying many inhabitants a political voice. Whose good is included, and whose interests are left out?",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-skilled-rule",
        "item": "civ-skilled-rule",
        "when": "created",
        "title": "Plato: ruling needs knowledge, not applause",
        "text": "Plato argues that ruling requires knowledge of what is good, not simply winning support. The claim does not settle who should be allowed a political voice.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-unequal-status",
        "item": "civ-unequal-status",
        "when": "created",
        "title": "A different legal order still divides people by status",
        "text": "Roman law distinguishes freeborn, freed and enslaved people. Those legal statuses give people different rights and are not the same as citizenship or participation in government in a Greek city.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-law-nature-tension",
        "item": "civ-law-nature-tension",
        "when": "created",
        "title": "Law upholds what it calls contrary to nature",
        "text": "Justinian's legal collection describes slavery as contrary to nature while continuing to regulate it. A stated principle therefore conflicts with the institution that the same law upholds.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-status-changed",
        "item": "civ-status-changed",
        "when": "created",
        "title": "An enslaved person becomes a freed person",
        "text": "Roman manumission legally changes an individual from enslaved to freed status. The institution of slavery can remain in place even though this person's status changes.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-reform-not-abolition",
        "item": "civ-reform-not-abolition",
        "when": "created",
        "title": "An individual route to freedom is not abolition",
        "text": "A route for freeing individuals leaves slavery as an institution in place. Relief within a system differs from ending the system.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-authoritative-lawbook",
        "item": "civ-authoritative-lawbook",
        "when": "created",
        "title": "Older law edited under imperial authority",
        "text": "The emperor's collection selects which older law is authoritative. Unlike an edition that displays variants, it also determines which text has legal force.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-interpreted-law",
        "item": "civ-interpreted-law",
        "when": "created",
        "title": "Inherited Roman law gains a medieval commentary",
        "text": "Medieval scholars at Bologna annotate Justinian's older law. Their commentary gives it new uses and meanings rather than simply continuing the sixth-century empire unchanged.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-protection-purpose",
        "item": "civ-protection-purpose",
        "when": "created",
        "title": "Hobbes makes protection a purpose of common power",
        "text": "Hobbes makes protection a central purpose of political authority. This answers the question of political benefit differently from the ancient accounts.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-hobbes-authority",
        "item": "civ-hobbes-authority",
        "when": "created",
        "title": "Hobbes: authorized sovereign power secures peace",
        "text": "Hobbes argues that authorized sovereign power can secure peace. The argument does not prove that concentrated power always succeeds.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-protection-boundary",
        "item": "civ-protection-boundary",
        "when": "created",
        "title": "Hobbes: lost protection can end obedience",
        "text": "Hobbes grounds political obedience in the sovereign's power to protect. If that protection is lost, the subject's duty can end. Merely disliking a decision is not the same condition.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-consent-government",
        "item": "civ-consent-government",
        "when": "created",
        "title": "Locke: legitimate government rests on consent",
        "text": "Locke grounds legitimate government in consent. Sharing humanity is not itself the same as consenting to a particular political authority.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-resistance",
        "item": "civ-resistance",
        "when": "created",
        "title": "Locke: breach of trust can justify resistance",
        "text": "Locke argues that a government's breach of trust can justify resistance. This does not guarantee success or imply that everyone then had an equal vote.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-rival-contracts",
        "item": "civ-rival-contracts",
        "when": "created",
        "title": "Protection and resistance yield rival accounts of authority",
        "text": "Hobbes emphasizes authorized power and protection; Locke emphasizes consent, trust and resistance to its breach. They offer different limits on authority, not one agreed social-contract doctrine.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-emancipation-demand",
        "item": "civ-emancipation-demand",
        "when": "created",
        "title": "Insurgents make freedom a political demand",
        "text": "Enslaved insurgents make freedom an active political demand. They are agents of change, not passive recipients of European ideas.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-emancipation-enacted",
        "item": "civ-emancipation-enacted",
        "when": "created",
        "title": "Emancipation becomes law amid revolution",
        "text": "During the revolution in Saint-Domingue, uprising, war and political pressure lead to abolition decrees. Emancipation becomes law, while enforcement and freedom in daily life remain further questions.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-abolition-in-empire",
        "item": "civ-abolition-in-empire",
        "when": "created",
        "title": "Abolition is claimed inside the French empire",
        "text": "The 1801 constitution rejects slavery but retains Saint-Domingue's connection with France. Abolition and independence are therefore distinct political achievements.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-work-consent",
        "item": "civ-work-consent",
        "when": "created",
        "title": "Compulsory cultivation challenges consent",
        "text": "Compulsory plantation work prevents people from freely choosing their work. It puts the ideal of consent in conflict with the actual working arrangement.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-freedom-practice",
        "item": "civ-freedom-practice",
        "when": "created",
        "title": "Abolition coexists with coercive labour",
        "text": "Saint-Domingue's 1801 constitution rejects slavery while maintaining compulsory plantation work. This exposes a limit on freedom at work without erasing the achievement of emancipation.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-independent-abolition",
        "item": "civ-independent-abolition",
        "when": "created",
        "title": "An independent state defends emancipation",
        "text": "Haiti's independence breaks France's claim to rule and defends emancipation. It does not remove every form of coercion or secure immediate international recognition.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-civ-rights-in-practice",
        "item": "civ-rights-in-practice",
        "when": "created",
        "title": "A commons must let people challenge coercive rules",
        "text": "Saint-Domingue's abolition did not automatically end compulsory work. The imagined shared-resource institution therefore needs a way for people to challenge coercive rules, not just a formal promise of freedom.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-linear-perspective",
        "item": "linear-perspective",
        "when": "created",
        "title": "A single-viewpoint perspective",
        "text": "Perspective represents a scene from one fixed eye position. It can make a convincing view without showing the whole place.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-bearing-chart",
        "item": "bearing-chart",
        "when": "created",
        "title": "A chart made for compass bearings",
        "text": "The chart helps a navigator follow compass directions. It does not preserve every area's size and shape.",
        "presentation": "explanation"
      },
      {
        "id": "plain-atlas-unequal-passenger-reception",
        "item": "unequal-passenger-reception",
        "when": "created",
        "title": "The moving midpoint receives platform-simultaneous flashes separately",
        "text": "Two flashes occur at a train's ends at the same time according to platform clocks. A passenger at the moving train's midpoint travels toward one flash and away from the other, so their light reaches the passenger at different times. These arrival times alone do not yet show when the flashes happened for the passenger.",
        "presentation": "explanation"
