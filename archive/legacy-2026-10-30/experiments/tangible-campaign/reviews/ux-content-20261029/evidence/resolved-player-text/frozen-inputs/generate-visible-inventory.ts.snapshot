import {mkdirSync,writeFileSync} from 'node:fs';
import {currentFamilies} from './candidate/experiments/tangible-campaign/ui/stories/current-ux-content.ts';
const rows:{world:string;surface:string;owner:string;field:string;text:string;context?:string}[]=[];
for(const s of currentFamilies){
 const add=(surface:string,owner:string,field:string,text:string|undefined,context?:string)=>{if(text?.trim())rows.push({world:s.id,surface,owner,field,text,...context?{context}:{}});};
 add('chooser',s.id,'title',s.title);add('chooser',s.id,'premise',s.premise);
 for(const i of s.items){add('tile/reader-caption',i.id,'label',i.label);if(i.labelAfterCreated)add('conditional tile/reader-caption',i.id,'labelAfterCreated.label',i.labelAfterCreated.label,'after '+i.labelAfterCreated.item);for(const [location,label]of Object.entries(i.labelByLocation??{}))add('owned-location tile/reader-caption',i.id,'labelByLocation',label,location);add('reader-body',i.id,'reading.text ?? description',i.reading?.text??i.description??i.label);if(!i.reading?.text&&!i.description){for(const [location,label]of Object.entries(i.labelByLocation??{}))add('reader fallback body',i.id,'labelByLocation',label,location);if(i.labelAfterCreated)add('reader conditional fallback body',i.id,'labelAfterCreated',i.labelAfterCreated.label,'after '+i.labelAfterCreated.item);}}
 for(const l of s.locationPlan?.locations??[])add('visible location label',l.id,'label',l.label);
 for(const h of s.hotspots){add('fixed-place label',h.id,'label',h.label);}
 for(const c of s.chapters){
  add('objective',c.id,'objectives',c.objectives.map(o=>o.text).join('\n'));
  add('entry fallback',c.id,'motivation',c.motivation);add('completion/ending',c.id,'completionText',c.completionText);add('skip bridge',c.id,'onAlreadyComplete.text',c.onAlreadyComplete?.text);add('source-update arrival fact',c.id,'sourceUpdate.arrivalFact',c.sourceUpdate?.arrivalFact);
  for(const [key,cue]of [['entryCue',c.entryCue],['travel.entryCue',c.travel?.entryCue]] as const){if(!cue)continue;add('story body',c.id,key+'.text',cue.text);add('story context heading',c.id,key+'.contextHeading',cue.contextHeading);}
 }
 for(const m of s.milestones??[]){add('wonder body',m.id,'text',m.text);const i=s.items.find(i=>i.id===m.item);if(m.presentation==='explanation'){add('wonder italic caption',m.id,'item.label',i?.label??m.title);for(const [location,label]of Object.entries(i?.labelByLocation??{}))add('wonder owned-location italic caption',m.id,'item.labelByLocation',label,location);}else {add('celebration heading',m.id,'title',m.title);add('celebration eyebrow',m.id,'eyebrow',m.eyebrow??'A new possibility');add('celebration object',m.id,'item.label',i?.label);for(const id of (m as any).components??[])add('celebration component',m.id,'component.label',s.items.find(i=>i.id===id)?.label);}if(m.artwork)add('art accessibility description',m.id,'artwork.alt',m.artwork.alt);}
}
const out=new URL('./evidence/resolved-player-text/',import.meta.url);mkdirSync(out,{recursive:true});writeFileSync(new URL('inventory.json',out),JSON.stringify({scope:'Resolved final composition, UI-visible fields only. Reader uses reading.text ?? description. Attribution/source/admin evidence excluded unless authored within visible prose. Each owned-location label variant listed explicitly; no source grep substitution.',rows},null,2)+'\n');writeFileSync(new URL('inventory.md',out),rows.map(r=>`## ${r.world} / ${r.surface} / ${r.owner}${r.context?' @ '+r.context:''}\n${r.text}\n`).join('\n'));console.log({worlds:currentFamilies.length,rows:rows.length});
