for(const mode of ['wheel-first','reservoir-first','random7','random29'])test(`waterworks independent preparations ${mode} and complete downstream route`,()=>{
 let g=earned('waterworks'),pending=block(),n=mode==='random7'?7:29;const actions:Action[]=[];let peak=local(g).length;const arrivalLabels=labels(g);
 while(pending.length){const available=pending.map((a,i)=>({a,i})).filter(({a})=>a.type==='combine'&&M.partners(s,g.state,a.a).outgoing.includes(a.b));assert(available.length);n=(n*1664525+1013904223)>>>0;const chosen=mode==='wheel-first'?available.find(x=>recipe(x.a)?.id==='water-lifting-wheel')??available[0]:mode==='reservoir-first'?available.find(x=>recipe(x.a)?.id==='reservoir')??available[0]:available[n%available.length];pending.splice(chosen.i,1);actions.push(chosen.a);g=step(g,chosen.a);peak=Math.max(peak,local(g).length);}
 assert(M.chapterComplete(s,g.state));durable(g);const end=rest('waterworks').findIndex(a=>a.type==='advance');g=finish(g,rest('waterworks').slice(end));write(mode,{completed:true,actions,arrivalLabels,peak});
});
