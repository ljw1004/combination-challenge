const dir=new URL('../results/elements-waterworks-v1/',import.meta.url);mkdirSync(dir,{recursive:true});
const route=s.checkpoints!.find(c=>c.id==='complete')!.actions;
const pair=(a:string,b:string)=>[a,b].sort().join('|');
const recipe=(a:Action,world=s)=>a.type==='combine'?world.recipes.find(r=>pair(r.a,r.b)===pair(a.a,a.b)):undefined;
const local=(g:M.Game)=>g.state.tokens.filter(t=>t.location===g.state.storyLocation);
const labels=(g:M.Game,world=s)=>local(g).map(t=>world.items.find(i=>i.id===t.kind)!.label);
const noMetrics=({metrics,...rest}:M.State)=>rest;
const step=(g:M.Game,a:Action,world=s)=>{const r=M.applyAction(world,g,a);assert(r.accepted,`${world.id}/${world.chapters[g.state.chapter]?.id}: ${JSON.stringify(a)} ${r.message}`);return r.game;};
const durable=(g:M.Game)=>{assert.deepEqual(M.restore(s,JSON.stringify(g)),g);assert.deepEqual(M.restore(s,JSON.stringify(toLegacyGame(g))),g);assert.deepEqual(M.restore(s,JSON.stringify(decodeSave(encodeSave({game:toLegacyGame(g),seen:[],tops:{}})).game)),g);};
const idx=(id:string)=>s.chapters.findIndex(c=>c.id===id);
const prefix=(id:string)=>s.checkpoints![idx(id)].actions;
const earned=(id:string,width=320)=>M.checkpoint(s,`chapter-${idx(id)+1}`,width);
const rest=(id:string)=>route.slice(prefix(id).length);
const block=()=>{const a=rest('waterworks');return a.slice(0,a.findIndex(x=>x.type==='advance'));};
function finish(g:M.Game,actions:Action[]){for(const a of actions)g=step(g,a);assert(g.state.completed);durable(g);return g;}
const write=(name:string,x:unknown)=>writeFileSync(new URL(name+'.json',dir),JSON.stringify(x,null,2)+'\n');

test('all 2411 inherited files have exact ancestry; v8 remains exact and v9 is a distinct registered identity',()=>{
 const root=new URL('../',import.meta.url),p='experiments/tangible-campaign/reviews/waterworks-release-20261029/predecessor-source-manifest.json',raw=readFileSync(new URL(p,root));assert.equal(createHash('sha256').update(raw).digest('hex'),'7629a2f122270c3b08a19a24e6251ae63f2f0178639b7576258b15ae003a4395');
 const files=JSON.parse(raw.toString()).files;assert.equal(Object.keys(files).length,2411);for(const[path,r]of Object.entries<any>(files))assert.equal(createHash('sha256').update(readFileSync(new URL(path,root))).digest('hex'),expectedSourceHashAfterWaterworks(path,r.sha256),path);
 assert.equal(scenarios.length,58);assert.equal(scenarios.find(x=>x.id===s.id),s);assert.equal(scenarios.find(x=>x.id===before.id),before);assert.equal(before.id,'elements-journey-cleanup-v8');assert(before.recipes.some(r=>r.id==='pump'));assert(!before.items.some(i=>i.id==='water-lifting-wheel'));assert.throws(()=>M.restore(s,JSON.stringify(M.createGame(before))),/Invalid campaign save/);
});
test('bounded closure delta, four primitives, unchanged goals/places/stock and clean lifecycle graphs',()=>{
 const l=toLegacyScenario(s);for(const errors of [M.validateScenario(s),validateContentLifecycles([l]),validateObjectiveFlow([l]),validateConstructionContinuity([l]),validateLifecycleGraph([l])])assert.deepEqual(errors,[]);
 assert.equal(route.length,223);assert.equal(s.items.length,before.items.length-1);assert.equal(s.recipes.length,before.recipes.length-1);assert.deepEqual(s.initialItems,before.initialItems);assert.deepEqual(s.locationPlan,before.locationPlan);assert.deepEqual(s.hotspots,before.hotspots);assert.deepEqual(s.milestones,before.milestones);assert.deepEqual(s.chapters.map(c=>c.objectives),before.chapters.map(c=>c.objectives));
 assert.deepEqual(s.locationPlan!.locations.flatMap(l=>l.stockBatches.flatMap(b=>b.items)),['earth','water','air','fire']);
 assert.deepEqual(s.recipes.filter(r=>before.recipes.some(x=>x.id===r.id)&&JSON.stringify(r)!==JSON.stringify(before.recipes.find(x=>x.id===r.id))).map(r=>r.id),['filled-reservoir']);
 for(const cp of s.checkpoints!)assert.deepEqual(cp.actions,route.slice(0,cp.actions.length));
 const uses=(id:string)=>s.recipes.filter(r=>[r.a,r.b].includes(id)).map(r=>r.id);assert.deepEqual(uses('water-lifting-wheel'),['filled-reservoir']);assert.deepEqual(uses('hollow-pipe'),['water-channel','water-filter']);assert.deepEqual(uses('waterwheel'),['mill-gearing','water-lifting-wheel']);
 const executable=JSON.stringify({items:s.items,recipes:s.recipes,goals:s.chapters.map(c=>c.objectives),checkpoints:s.checkpoints});for(const id of ['pump','water-pump'])assert(!executable.includes('"'+id+'"'));
 for(const id of ['hammer','telescope'])assert.deepEqual(s.recipes.find(r=>r.id===id),before.recipes.find(r=>r.id===id));
 write('consumer-closure',{removed:['pump','water-pump'],added:s.recipes.find(r=>r.id==='water-lifting-wheel'),consumers:Object.fromEntries(['waterwheel','glazed-bottle','hollow-pipe','water-lifting-wheel','reservoir','filled-reservoir','water-channel','irrigation-channel','irrigated-garden'].map(id=>[id,uses(id)])),goals:s.chapters.map(c=>({id:c.id,objectives:c.objectives})),primitiveStock:['earth','water','air','fire']});
});
for(const[mode,width]of [['combine',375],['drop',320],['reverse',390]]as const)test(`complete ${mode}/${width}: local carry, highlights, lifecycle, goals, bounds, saves and Undo`,()=>{
 let g=M.createGame(s,width);const density:any[]=[];const witnesses:any[]=[];
 for(const[n,a]of route.entries()){
  const row=density[g.state.chapter]??={chapter:s.chapters[g.state.chapter].id,arrival:local(g).length,arrivalLabels:labels(g),peak:0,peakLabels:[]};if(local(g).length>row.peak){row.peak=local(g).length;row.peakLabels=labels(g);}
  const r=recipe(a),old=g;if(a.type==='combine'){for(const id of[a.a,a.b])if(!id.startsWith('@'))assert.equal(M.token(g.state,id)?.location,g.state.currentLocation,n+'/'+id);assert(M.partners(s,g.state,a.a).outgoing.includes(a.b));}
  const reverse=mode==='reverse'&&a.type==='combine'&&!a.a.startsWith('@')&&!a.b.startsWith('@')&&!r?.at;
  if(reverse&&a.type==='combine')assert(M.partners(s,g.state,a.b).outgoing.includes(a.a));
  const actual:Action=a.type==='combine'&&mode!=='combine'?{type:'drop',item:reverse?a.b:a.a,target:reverse?a.a:a.b}:a;g=step(g,actual);
  for(const t of g.state.tokens){assert(t.x>=48&&t.x<=g.state.width-48,t.id+' x');assert(t.y-M.tokenHeight(s,t)/2>=0&&t.y+M.tokenHeight(s,t)/2<=844,t.id+' y');}
  if(a.type==='advance'){assert.deepEqual(old.state.tokens.map(t=>t.id).sort(),g.state.tokens.map(t=>t.id).sort());assert.deepEqual(noMetrics(M.undo(g).game.state),noMetrics(old.state));}
  if(r&&['water-lifting-wheel','filled-reservoir','irrigation-channel','irrigated-garden','fill-water-bottle','cover-filled-water-bottle','water-filter'].includes(r.id)){
   assert.deepEqual(noMetrics(M.undo(g).game.state),noMetrics(old.state));durable(g);assert(!M.applyAction(s,g,a).accepted);witnesses.push({recipe:r.id,before:M.playerView(s,old),after:M.playerView(s,g)});
  }
  if(r?.id==='water-lifting-wheel'){assert(!M.token(g.state,'waterwheel'),'the already-used mill supply is transformed now, not invisibly later');assert(M.token(g.state,'glazed-bottle'),'remaining ceramic water service stays tangible');}
  if(g.state.chapter>idx('waterworks'))for(const id of ['water-lifting-wheel','filled-reservoir','irrigated-garden'])assert.equal(M.token(g.state,id)?.location,'E03-irrigation-bank');
 }
 assert(g.state.completed);durable(g);write(mode+'-'+width,{completed:true,actions:route.length,density,witnesses,evidenceLevel:'Logical API, not native/browser/human evidence.'});
});
