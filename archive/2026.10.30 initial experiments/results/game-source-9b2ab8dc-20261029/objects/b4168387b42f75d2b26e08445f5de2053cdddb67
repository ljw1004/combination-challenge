  board.onpointerdown({target:src,button:0,clientX:60,clientY:100,pointerId:1,preventDefault(){}});assert(dst.classes.has('possible'));h.setHit(dst);board.onpointermove({clientX:210,clientY:250,pointerId:1});assert(dst.classes.has('possible'));board.onpointerup({clientX:210,clientY:250,pointerId:1});let g=hstate(h);assert.equal(g.events.length,old.events.length+1,'pointer handler commits exactly one action');assert(g.events.at(-1)!.accepted);assert.equal(g.events.at(-1)!.action.type,'drop');actions.push({type:'drop',item:source,target});peak=Math.max(peak,local(g).length);
