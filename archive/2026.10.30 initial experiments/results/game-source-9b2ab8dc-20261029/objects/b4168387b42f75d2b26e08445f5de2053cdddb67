const hstate=(h:ReturnType<typeof locationHarness>)=>fromLegacyGame(h.state());
const harness=(g:M.Game)=>locationHarness(s,JSON.stringify({game:toLegacyGame(g),seen:[],tops:{}}),{width:320,modernPointer:true});
function settle(h:ReturnType<typeof locationHarness>,chapter:number){for(let n=0;n<100;n++){if(hstate(h).state.chapter!==chapter||hstate(h).state.completed)return;if(h.button('milestone')?.open){h.click(h.button('milestone-continue'));continue;}if(h.button('mission')?.open){h.click(h.button('close'));continue;}const t=h.timers.find(t=>!t.ran&&!t.cancelled&&(t.ms===0||t.ms===700));if(t){t.fn();continue;}return;}throw Error('Unsettled controller queue');}
