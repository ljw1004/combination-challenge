});
test('wrong pairs remain ordinary non-combinations with no magical sound or intention token',()=>{
 let g=atGate();for(const [a,b] of [['basin','mallet'],['mallet','hanger']]){
  const r=M.applyAction(s,g,M.dropAction(s,g.state,a,b));assert(!r.accepted);assert.deepEqual(r.game.state.tokens,g.state.tokens);
 }
 assert(s.items.every(i=>!i.id.includes('purpose')&&!i.id.includes('sound')));
