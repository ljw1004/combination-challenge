test('gust is visible next-scene narrative, not hidden description or simulated engine event',()=>{
 assert.match(s.stages[1].motivation,/gust rocks it against the iron latch/);
 assert.match(M.playerView(s,atGate()).stage.motivation,/clang brings the keeper out/);
