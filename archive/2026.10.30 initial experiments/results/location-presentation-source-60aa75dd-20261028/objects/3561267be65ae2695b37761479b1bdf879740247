// Logical integration of the approved short probe; no browser/UI test. Source candidate tests adapted to current unchanged engine and earned checkpoints.
import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import * as M from '../experiments/tangible-campaign/engine/model.ts';
import {validateContentLifecycles,validateConstructionContinuity,validateObjectiveFlow} from '../experiments/tangible-campaign/schema/lifecycle.ts';
import type {Scenario,Action} from '../experiments/tangible-campaign/schema/scenario.ts';
import {scenario as s} from '../experiments/tangible-campaign/ui/campaigns/purpose.ts';
import {presentationFor} from '../experiments/tangible-campaign/ui/pre-location-scenarios-v1.ts';
const route:Action[]=JSON.parse(readFileSync(new URL('../experiments/tangible-campaign/evidence/integration-20261028/sources/causation/reconsideration/accidental-bell-v1/author-route.json',import.meta.url),'utf8'));
const sha=(b:Uint8Array)=>createHash('sha256').update(b).digest('hex');
const atGate=()=>M.replay(s,route.slice(0,3));
const act=(g:M.Game,a:Action)=>{const r=M.applyAction(s,g,a);assert(r.accepted,r.message);return r.game;};
const drop=(g:M.Game,a:string,b:string)=>act(g,M.dropAction(s,g.state,a,b));

test('content, explicit input lifecycles, objective flow and preservation contracts',()=>{
 assert.deepEqual(M.validateScenario(s),[]);assert.deepEqual(validateContentLifecycles([s]),[]);
 assert.deepEqual(validateObjectiveFlow([s]),[]);assert.deepEqual(validateConstructionContinuity([s]),[]);
 assert.equal(s.stages.length,2);assert.equal(s.recipes.length,3);assert.equal(s.checkpoints?.length,3);
});


test('opening is the real beginning: only unworked blank and actual mallet',()=>{
 const g=M.createGame(s);assert.equal(g.state.stage,0);assert.equal(g.events.length,0);
 assert.deepEqual(g.state.tokens.map(t=>t.kind),['blank','mallet']);
 assert(!M.token(g.state,'basin'));assert(!M.token(g.state,'gong'));assert(!M.token(g.state,'hanger'));
});
test('full authored route reaches final state in three combinations, two placements, two advances',()=>{
 const g=M.replay(s,route);assert(g.state.completed);assert.equal(g.state.metrics.combinations,3);
 assert.equal(g.state.metrics.installations,1);assert.equal(g.state.metrics.creations,2);
 assert.equal(g.state.metrics.placements,2);assert.equal(g.state.metrics.advances,2);assert.equal(g.events.length,7);
});
test('making and deploying the washbasin are distinct; raw blank does not rinse brushes',()=>{
 let g=M.createGame(s);g=drop(g,'blank','@wash');assert(!M.stageComplete(s,g.state));
 g=drop(g,'blank','mallet');assert(M.stageComplete(s,g.state));assert.equal(M.token(g.state,'basin')!.location,'wash');
 const unplaced=drop(M.createGame(s),'blank','mallet');assert(!M.stageComplete(s,unplaced.state));
});
test('shaping preserves the actual mallet and replaces the blank at its position in either direction',()=>{
 for(const reverse of [false,true]){
  const g=M.createGame(s),blank=M.token(g.state,'blank')!,mallet=M.token(g.state,'mallet')!;
  const r=M.applyAction(s,g,M.dropAction(s,g.state,...(reverse?['mallet','blank']:['blank','mallet']) as [string,string]));assert(r.accepted);
  const basin=M.token(r.game.state,'basin')!;assert.deepEqual([basin.x,basin.y],[blank.x,blank.y]);
  assert(!M.token(r.game.state,'blank'));assert.deepEqual(M.token(r.game.state,'mallet'),mallet);assert(basin.incorporated.includes('blank'));
 }
});
test('scene transition carries the earned basin and same mallet, without fresh duplicates',()=>{
 const before=M.replay(s,route.slice(0,2)),after=atGate();
 for(const id of ['basin','mallet']){
  assert.equal(after.state.tokens.filter(t=>t.kind===id).length,1);
  assert.deepEqual(M.token(after.state,id)!.incorporated,M.token(before.state,id)!.incorporated);
  assert.equal(M.token(after.state,id)!.area,'courtyard');
 }
 assert.deepEqual(s.stages[1].caches!.flatMap(c=>c.items),['hanger']);
 assert(after.events.some(e=>e.created==='basin'&&e.stage===0));
});
test('suspension transforms the actual basin, visibly preserves hardware, and keeps mallet loose',()=>{
 for(const reverse of [false,true]){
  const g=atGate(),before=M.token(g.state,'basin')!;
  const after=drop(g,...(reverse?['hanger','basin']:['basin','hanger']) as [string,string]);
  const gong=M.token(after.state,'gong')!;
  assert(!M.token(after.state,'basin'));assert(!M.token(after.state,'hanger'));assert(M.token(after.state,'mallet'));
  assert.deepEqual([gong.x,gong.y],[before.x,before.y]);
  for(const k of ['blank','basin','hanger'])assert(gong.incorporated.includes(k),k);
  assert.deepEqual(M.componentLabels(s,gong),['Crossbar, hooks and cords']);assert(!M.functional(s,gong));
 }
});
test('mounting an empty suspended basin does not claim a ready visitor call fixture',()=>{
 let g=atGate();g=drop(g,'basin','hanger');g=drop(g,'gong','@gate');
 assert(!M.stageComplete(s,g.state));assert.equal(M.playerView(s,g).completionText,null);
 assert(!M.capabilities(s,M.token(g.state,'gong')!).includes('visitor-call'));
});
test('installation retains same assembly and visibly tethers actual earlier mallet in both directions',()=>{
 for(const reverse of [false,true]){
  const g=drop(atGate(),'basin','hanger'),before=M.token(g.state,'gong')!;
  const after=drop(g,...(reverse?['gong','mallet']:['mallet','gong']) as [string,string]);
  const gong=M.token(after.state,'gong')!;assert.equal(gong.id,before.id);assert.deepEqual([gong.x,gong.y],[before.x,before.y]);
  assert.equal(gong.slots.striker,'mallet');assert(gong.incorporated.includes('mallet'));assert(!M.token(after.state,'mallet'));
  assert.deepEqual(M.componentLabels(s,gong),['Crossbar, hooks and cords']);assert(M.functional(s,gong));
  assert.equal(M.playerView(s,after).things.find(t=>t.id==='gong')!.slots[0].label,'Wooden mallet');
 }
});
