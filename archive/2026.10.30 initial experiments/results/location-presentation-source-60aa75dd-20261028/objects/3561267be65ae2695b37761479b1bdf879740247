test('final result identifies concrete visitor, actual striker and keeper response',()=>{
 const v=M.playerView(s,M.replay(s,route));assert.match(v.completionText!,/visitor lifts the tethered mallet/);
 assert.match(v.completionText!,/strikes your hanging basin/);assert.match(v.completionText!,/keeper comes out and opens the gate/);
