test('all prefixes restore exactly; undo installation returns the same earlier mallet',()=>{
 for(let n=0;n<=route.length;n++){const g=M.replay(s,route.slice(0,n));assert.deepEqual(M.restore(s,JSON.stringify(g)).state,g.state);}
 const before=M.replay(s,route.slice(0,4)),installed=act(before,route[4]),undone=M.undo(installed);
 assert(undone.accepted);assert.deepEqual(undone.game.state.tokens,before.state.tokens);assert(!M.token(undone.game.state,'gong')!.slots.striker);
});
test('author routes/drop directions are valid at all supported sample widths',()=>{
 for(const width of [320,360,600])for(const reversed of [false,true]){
  const actions=route.map(a=>a.type==='combine'&&reversed?{...a,a:a.b,b:a.a}:a);
  assert(M.replay(s,actions,width).state.completed);
 }
});
test('minimum is five DROP gestures: bounded canonical local-state search, not move count padding',()=>{
 const key=(g:M.Game)=>JSON.stringify({stage:g.state.stage,done:g.state.completed,t:g.state.tokens.map(t=>[t.kind,t.area,t.location,t.slots]).sort(),d:[...g.state.discovered].sort(),r:[...g.state.recipesUsed].sort()});
 const q:{g:M.Game;drops:number;actions:Action[]}[]=[{g:M.createGame(s),drops:0,actions:[]}],seen=new Set<string>();let shortest:number|undefined,witness:Action[]=[];let terminal=0;
 while(q.length){const x=q.shift()!;const k=key(x.g);if(seen.has(k))continue;seen.add(k);
  if(x.g.state.completed){terminal++;if(shortest===undefined){shortest=x.drops;witness=x.actions;}continue;}
  const local=x.g.state.tokens.filter(t=>t.area===x.g.state.currentArea),places=x.g.state.places.filter(p=>p.area===x.g.state.currentArea);const candidates:Action[]=[];
  for(let i=0;i<local.length;i++)for(let j=i+1;j<local.length;j++)candidates.push(M.dropAction(s,x.g.state,local[i].id,local[j].id));
  for(const t of local)for(const p of places)candidates.push(M.dropAction(s,x.g.state,t.id,'@'+p.id));
  for(const a of candidates){let r=M.applyAction(s,x.g,a);if(!r.accepted)continue;let g=r.game,actions=[...x.actions,a];
   if(M.stageComplete(s,g.state)){const advance:Action={type:'advance'};g=act(g,advance);actions.push(advance);}
   q.push({g,drops:x.drops+1,actions});
  }
 }
 assert.equal(shortest,5);assert(terminal>0);
 assert.equal(seen.size,20);assert.equal(terminal,1);assert.equal(witness.filter(a=>a.type==='combine').length,3);assert.equal(witness.filter(a=>a.type==='place').length,2);
});

