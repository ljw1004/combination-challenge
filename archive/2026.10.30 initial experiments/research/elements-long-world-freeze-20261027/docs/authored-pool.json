  "newGoals": [
    {
      "id": "crossing",
      "title": "A dry way across",
      "requirement": "Make a crossing people can walk over. A ferry still has its own uses.",
      "requires": [
        "walk-crossing"
      ]
    },
    {
      "id": "water-work",
      "title": "Let the river lend a hand",
      "requirement": "Make moving water do useful work. Hand tools and hand-ground flour still work.",
      "requires": [
        "water-work"
      ]
    },
    {
      "id": "loads",
      "title": "More than we can carry",
      "requirement": "Move something bulky without carrying it in your arms.",
      "requires": [
        "move-load"
      ]
    },
    {
      "id": "find-us",
      "title": "Help people find this place",
      "requirement": "A sign in daylight or a signal seen from farther away: choose what belongs here.",
      "requires": [
        "wayfinding"
      ]
    },
    {
      "id": "return",
      "title": "Somewhere worth returning to",
      "requirement": "A place for stories, performance, art, or growing things. Something you already made can be enough.",
      "requires": [
        "return-place"
      ]
    },
    {
      "id": "send",
      "title": "Let something made here travel",
      "requirement": "Send words, pictures, or hospitality across the water.",
      "requires": [
        "carried-work"
      ]
    },
    {
      "id": "observe",
      "title": "Look more closely",
      "requirement": "Record something about the plants, weather or sky here.",
      "requires": [
        "observation"
      ]
    },
    {
      "id": "cultivate",
      "title": "Give growing things a good home",
      "requirement": "A sheltered bed, support to climb, or a reliable way to bring water.",
      "requires": [
        "cultivation"
      ]
    },
    {
      "id": "household",
      "title": "Make everyday work gentler",
      "requirement": "Make a washing material, a different light, or shelter from the weather.",
      "requires": [
        "household-making"
      ]
    },
    {
      "id": "landing",
      "title": "A welcome in the rain",
      "requirement": "Give the landing a roof that keeps a visitor dry.",
      "requires": [
        "weather-welcome"
      ]
    },
    {
      "id": "public-story",
      "title": "A place for stories together",
      "requirement": "Make a place for children to find books, or for a courtyard performance.",
      "requires": [
        "public-story"
      ]
    },
    {
      "id": "record",
      "title": "Leave a record of this place",
      "requirement": "Make an atlas, a botanical display, or a place to show pictures.",
      "requires": [
        "record"
      ]
    }
  ]
}
