const rights=after.items.find(i=>i.id==='universal-rights')!;assert.match(rights.reading!.text,/shared humanity or political consent/);assert.ok(rights.sources!.includes('civ-locke'));assert.match(rights.reading!.attribution,/John Locke/);assert.equal(after.recipes.filter(r=>r.out==='universal-rights').length,2);
