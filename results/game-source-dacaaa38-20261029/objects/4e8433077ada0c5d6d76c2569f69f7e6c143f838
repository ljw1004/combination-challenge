const dir=new URL('./',import.meta.url),sha=(v:unknown)=>crypto.createHash('sha256').update(JSON.stringify(v)).digest('hex'),write=(n:string,v:unknown)=>fs.writeFileSync(new URL(n,dir),JSON.stringify(v,null,2)+'\n');
const allowed=new Set(['id','items','recipes','sources','notes']);for(const k of Object.keys(after) as (keyof typeof after)[])if(!allowed.has(k))assert.deepEqual(after[k],before[k],k+' changed outside source repair');
