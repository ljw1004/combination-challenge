  {
    "uid": "C1047",
    "text": "Case: one infant ill, one well; neither chose wrong",
    "occurrences": [
      {
        "row": 4642,
        "world": "divinity-final-reading-scenes-v7",
        "surface": "tile/reader-caption",
        "owner": "two-infants",
        "field": "label"
      }
    ]
  },
  {
    "uid": "C1048",
    "text": "One infant is ill and the other is well. Neither has chosen a wrongful act. Does either child's health determine a need for forgiveness?",
    "occurrences": [
      {
        "row": 4643,
        "world": "divinity-final-reading-scenes-v7",
        "surface": "reader-body",
        "owner": "two-infants",
        "field": "reading.text ?? description"
      }
    ]
  },
  {
    "uid": "C1049",
    "text": "The sick infant has not chosen wrong; neither has the healthy infant",
    "occurrences": [
      {
        "row": 4644,
        "world": "divinity-final-reading-scenes-v7",
        "surface": "tile/reader-caption",
        "owner": "health-not-moral-test",
        "field": "label"
      }
    ]
  },
  {
    "uid": "C1050",
    "text": "Neither infant has chosen a wrong act. Illness in one child is not evidence that the child deliberately did wrong.",
    "occurrences": [
