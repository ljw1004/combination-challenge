        "surface": "tile/reader-caption",
        "owner": "source-rule",
        "field": "label"
      }
    ]
  },
  {
    "uid": "C0784",
    "text": "The Book of Two Principles claims that a wholly good source cannot produce evil. That rule is an extra premise in its argument, not something proved merely by noticing suffering.",
    "occurrences": [
      {
        "row": 4373,
        "world": "divinity-final-reading-scenes-v7",
        "surface": "reader-body",
        "owner": "source-rule",
        "field": "reading.text ?? description"
      }
    ]
  },
