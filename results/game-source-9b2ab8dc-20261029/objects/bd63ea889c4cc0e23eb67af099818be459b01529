        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C1046",
    "text": "A better history could support the bone's claimed identity, but Calvin would still reject religious honour to it. Whose bone it is and whether it should be venerated are different questions.",
    "occurrences": [
      {
        "row": 4641,
        "world": "divinity-final-reading-scenes-v7",
        "surface": "reader-body",
        "owner": "evidence-not-consensus",
        "field": "reading.text ?? description"
      }
