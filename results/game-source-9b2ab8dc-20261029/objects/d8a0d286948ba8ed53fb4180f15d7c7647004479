      }
    ]
  },
  {
    "uid": "C0408",
    "text": "Longitude from two kinds of time",
    "occurrences": [
      {
        "row": 2709,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder italic caption",
        "owner": "plain-atlas-time-longitude",
        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C0409",
    "text": "The report describes how Harrison's H4 clock kept the time of a known place during a sea voyage. Comparing that reference time with local noon gives longitude: how far east or west the observer is from that place. The successful trial supports the method, but does not certify every clock. Further testing and the reward remained disputed.",
    "occurrences": [
      {
        "row": 2710,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder body",
        "owner": "plain-atlas-sea-tested-clock",
        "field": "text"
      }
    ]
  },
  {
    "uid": "C0410",
    "text": "Sea-tested reference time",
    "occurrences": [
      {
        "row": 2711,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder italic caption",
        "owner": "plain-atlas-sea-tested-clock",
        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C0411",
