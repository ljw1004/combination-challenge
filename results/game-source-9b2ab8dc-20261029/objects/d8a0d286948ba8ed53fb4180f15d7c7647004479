        "surface": "wonder body",
        "owner": "plain-atlas-lunar-longitude",
        "field": "text"
      }
    ]
  },
  {
    "uid": "C0414",
    "text": "A lunar route to longitude",
    "occurrences": [
      {
        "row": 2715,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder italic caption",
