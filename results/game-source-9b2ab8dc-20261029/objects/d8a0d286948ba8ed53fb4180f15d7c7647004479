      }
    ]
  },
  {
    "uid": "C0392",
    "text": "A figure moved by a copied gear linkage",
    "occurrences": [
      {
        "row": 2693,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder italic caption",
        "owner": "plain-atlas-clockwork-figure",
        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C0393",
    "text": "A gear-driven figure can copy an animal's movement. That alone does not show feeding, growth, repair or sensation. Mechanical imitation and a complete explanation of life are different achievements.",
