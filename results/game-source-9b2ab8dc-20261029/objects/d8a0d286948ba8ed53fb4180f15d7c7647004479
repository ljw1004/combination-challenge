        "surface": "wonder italic caption",
        "owner": "plain-atlas-newtonian-framework",
        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C0407",
    "text": "A difference between local time and reference time gives an east\u2013west position difference. The method depends on a reliable reference.",
