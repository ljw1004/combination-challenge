        "surface": "wonder body",
        "owner": "plain-atlas-lunar-reference",
        "field": "text"
      }
    ]
  },
  {
    "uid": "C0412",
    "text": "Reference time read from the Moon",
    "occurrences": [
      {
        "row": 2713,
        "world": "atlas-focused-sessions-v6",
