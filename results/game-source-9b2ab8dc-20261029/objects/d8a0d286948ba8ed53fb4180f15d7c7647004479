        "field": "text"
      }
    ]
  },
  {
    "uid": "C0394",
    "text": "Imitated motion does not establish a living animal",
    "occurrences": [
      {
        "row": 2695,
        "world": "atlas-focused-sessions-v6",
        "surface": "wonder italic caption",
        "owner": "plain-atlas-imitation-limit",
        "field": "item.label"
      }
    ]
  },
  {
    "uid": "C0395",
