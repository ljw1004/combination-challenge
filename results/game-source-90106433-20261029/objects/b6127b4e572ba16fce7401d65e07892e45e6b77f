import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {createHash} from 'node:crypto';
import {acceptedTestRoute} from '../experiments/tangible-campaign/integration/accepted-current-test-routes.ts';import {toLegacyScenario,fromLegacyAction} from '../experiments/tangible-campaign/compatibility/v1.ts';
import {scenarios} from '../experiments/tangible-campaign/ui/current-scenarios.ts';import {applyMilestones} from '../experiments/tangible-campaign/ui/current-campaign.ts';import * as M from '../experiments/tangible-campaign/engine/campaign.ts';
const baseline=JSON.parse(readFileSync(new URL('../experiments/tangible-campaign/reviews/mars-creature-field-scenes/existing53-baseline.json',import.meta.url),'utf8'));const sha=(x:unknown)=>createHash('sha256').update(JSON.stringify(x)).digest('hex');
assert.equal(baseline.baseSourceSeal,'dacaaa3832d19900f790a9cd5e571bf790a2cf435e2f32f1bb259861008c80b9');assert.equal(scenarios.length,56);assert.equal(baseline.records.length,53);const preserved=baseline.records.map((row:any)=>{const s=scenarios.find(s=>s.id===row.id);assert(s,'Missing preserved world '+row.id);return s;});assert.deepEqual(scenarios.filter(s=>!baseline.records.some((r:any)=>r.id===s.id)).map(s=>s.id).sort(),['atlas-selection-repairs-v5','elements-material-repairs-v6','mars-evidence-repairs-v7']);
for(const raw of preserved)test(`${raw.id}: exact original state/event/history at every route action and every checkpoint`,()=>{const s=applyMilestones(raw),row=baseline.records.find((r:any)=>r.id===s.id);assert(row);assert.equal(sha(s),row.scenario);assert(!s.locationPlan?.visits.some(v=>v.carryAlong));let g=M.createGame(s,390);assert.equal(sha(g.state),row.route[0].state);const accepted=acceptedTestRoute(toLegacyScenario(s)),actions=accepted.actions.map(fromLegacyAction);assert.deepEqual(accepted.source,row.routeSource);assert.equal(sha(actions),sha(row.routeActions));assert.equal(actions.length+1,row.route.length);for(const [i,a]of actions.entries()){const result=M.applyAction(s,g,a);assert(result.accepted);g=result.game;assert.equal(sha(g.state),row.route[i+1].state,`state action ${i+1}`);assert.equal(sha(g.events.at(-1)),row.route[i+1].event,`event action ${i+1}`);assert.equal(g.history.length,row.route[i+1].history);}assert(g.state.completed);for(const c of row.checkpoints)assert.equal(sha(M.checkpoint(s,c.id,390)),c.game,c.id);});
