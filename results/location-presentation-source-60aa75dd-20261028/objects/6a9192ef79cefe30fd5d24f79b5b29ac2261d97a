import json,pathlib
ROOT=pathlib.Path(__file__).resolve().parents[4]
items=[]; recipes=[]; stages=[]; routes=[]; current=[]
def I(id,label,text=None,attribution=None,sources=(),caveat=None):
 d={'id':id,'label':label}
 if text:d['reading']={'text':text,'attribution':attribution or 'Editorial learning note; not a claim about the player’s beliefs.'}
 if sources:d['sources']=list(sources)
 if caveat:d['caveat']=caveat
 items.append(d)
def R(a,b,out,label,text,*,attribution=None,sources=(),transform=None,incorporate=(),at=None):
 I(out,label,text,attribution,sources)
 roles={}
 for x in (a,b):
  if x.startswith('@'):continue
  role='transform' if x==transform else 'incorporate' if x in incorporate else 'retain'
  roles[x]={'role':role,'reason':('The working note is revised into this fuller note at this event.' if role=='transform' else 'This note becomes part of the combined case file at this event.' if role=='incorporate' else 'The source or earlier conclusion remains available for rereading and later comparison.')}
 r={'id':'dl-'+out,'a':a,'b':b,'out':out,'lifecycle':roles}
 if at:r['at']=at
 if sources:r['sources']=list(sources)
 recipes.append(r); current.append(r['id'])
def S(id,title,motivation,supplies,carry,goals,locations=(),bridge=None):
 st={'id':id,'title':title,'speaker':'Guide editor','motivation':motivation,'area':{'id':id,'label':title,'travelText':title},'onAlreadyComplete':{'mode':'bridge','text':bridge} if bridge else {'mode':'skip'},'carry':carry,'objectives':[]}
 if supplies:st['caches']=[{'id':id+'-sources','label':'Sources and case papers','narrative':'These sources and clearly marked classroom cases are available on this desk.','items':supplies}]
 if locations:st['locations']=list(locations)
 for n,(item,text,intermediate,after) in enumerate(goals):
  o={'id':id+'-'+str(n+1),'kind':'create','item':item,'text':text}
  if intermediate:o['intermediate']=True
  if after:o['after']=[id+'-'+str(x) for x in after]
  st['objectives'].append(o)
 stages.append(st);routes.append(current.copy());current.clear()
# 1: two actual Gospel stories; their conclusions remain in tension with later cases.
I('neighbor-question','“Who is my neighbor?”','A lawyer asks Jesus this question after discussing love of God and neighbor. Jesus answers with a story, then asks which person acted as a neighbor. Notice how the question changes.','Luke 10:29–37. The brief quotation is World English Bible Classic (public domain); context is an editorial paraphrase.',['luke10'])
I('samaritan-story','Luke: a Samaritan stops to help','In Jesus’ story, a traveler is hurt on the road. Two travelers pass by. A Samaritan stops, tends to him, takes him to an inn, and pays for his care. Jesus ends: “Go and do likewise.”','Luke 10:30–37, paraphrase; closing words quoted from World English Bible Classic (public domain).',['luke10'])
I('samaritan-context','The helper comes from a different community','Samaritans and Jews were distinct, related religious communities with disagreements about worship. Jesus is Jewish. Making a Samaritan the helper challenges a familiar boundary; it does not make every member of either group good or bad.','Historical context for Luke 10 and John 4:9, 20–22; editorial summary.',['luke10','john4'])
I('lost-son','Luke: a father welcomes his returning son','A younger son wastes his inheritance and returns home. His father welcomes him. The story does not end with the welcome: an older brother objects to the celebration.','Editorial paraphrase of Luke 15:11–32.',['luke15'])
I('older-brother','The older brother says the welcome is unfair','The older brother has stayed and worked. He resents the celebration for his returning brother. His father goes out to speak with him too. The story leaves us with the older brother’s response still open.','Editorial paraphrase of Luke 15:25–32.',['luke15'])
I('parable-lens','A parable invites its listener into a question','A parable is a teaching story. Its characters, surprises, and ending matter. Reading one is not the same task as checking a newspaper report or a laboratory measurement.','Editorial literary-reading guide, informed by Dei Verbum §12; not a claim that every biblical passage is a parable.',['dei-verbum'])
R('neighbor-question','samaritan-story','neighbor-action','Being a neighbor means showing mercy','Jesus’ closing question draws attention to what the helper did. The story turns a question about who counts as a neighbor into a challenge to act with mercy.',sources=['luke10'])
R('samaritan-story','samaritan-context','unexpected-helper','An unexpected person becomes the helper','The Samaritan’s care matters partly because a listener might not expect him to be the example. This is a reading of the story, not a judgment of whole religious communities.',sources=['luke10','john4'])
R('neighbor-action','unexpected-helper','neighbor-care','Mercy can cross a community boundary','The helper’s actions, not his group label, answer Jesus’ final question. This conclusion will travel into later classroom cases about whom a community notices.',sources=['luke10'],transform='neighbor-action',incorporate=['unexpected-helper'])
R('lost-son','older-brother','two-brothers','The welcome raises a question for both brothers','The younger son returns; the older son resents the welcome. The father reaches toward both. A reading that forgets the older brother misses the story’s unfinished invitation.',sources=['luke15'])
R('two-brothers','parable-lens','parable-response','The story asks how its listener will respond','The older brother’s unresolved response leaves room for the listener. A parable may unsettle an easy answer rather than supply a list of people to praise or blame.',sources=['luke15','dei-verbum'],transform='two-brothers')
S('stories','1 · Two stories, open questions','A class is making a small guide for an exhibition on faith, questions, and life together. Begin with two Gospel stories. These are interpretations to examine, not tests of your faith.',['neighbor-question','samaritan-story','samaritan-context','lost-son','older-brother','parable-lens'],[],[('neighbor-action','Find the neighbor’s action',True,[]),('neighbor-care','Follow the unexpected helper',False,[1]),('two-brothers','Hear both brothers',True,[]),('parable-response','Find the story’s open question',False,[3])])
# 2: source form, different emphases, Jewish context.
I('luke-prologue','Luke explains why he writes an account','A Gospel is a Christian account of Jesus’ life and teaching. Luke’s opening says that others have written accounts and that he has investigated the events. He addresses Theophilus and explains his purpose. This opening differs in form from a parable told within the Gospel.','Editorial paraphrase of Luke 1:1–4.',['luke1'])
I('mark-bread','Mark: compassion for a hungry crowd','Mark tells of Jesus teaching and feeding a large crowd. His account first describes Jesus’ compassion for people like sheep without a shepherd. Five loaves and two fish are shared.','Editorial paraphrase of Mark 6:30–44; a Gospel’s testimony, not a laboratory report.',['mark6'])
I('john-bread','John: bread, a sign, and a coming Passover','John also tells of feeding a large crowd. He mentions Passover, identifies a boy’s barley loaves, and follows the meal with a discussion of bread and life. These details shape his account.','Editorial paraphrase of John 6:1–15, 22–35.',['john6'])
I('jewish-world','Jesus and his first followers are Jewish','The Gospels belong to the world of Jewish Scripture, worship, festivals, and debate under Roman rule. Judaism is a living tradition, not merely Christianity’s unfinished first chapter. Do not turn disagreements within Gospel stories into blame against Jews as a people.','Historical context and Catholic interpretive safeguard: Nostra Aetate §4; Gospel context in John 6.',['nostra','john6'])
R('parable-response','luke-prologue','genre-purpose','Ask what kind of writing this is','A Gospel can contain teaching stories and also a writer’s account of events and purpose. Notice the form of a passage before deciding what question it can answer.',sources=['luke1','dei-verbum'])
R('mark-bread','john-bread','shared-scene','Two Gospels tell the feeding of a crowd','The shared episode makes a close comparison possible. Similarities do not erase each writer’s selection of details. The game is comparing accounts, not deciding whether a miracle occurred.',sources=['mark6','john6'])
R('shared-scene','genre-purpose','gospel-emphases','A shared scene has different emphases','Mark foregrounds compassion and the shepherd image; John mentions Passover and develops the bread theme. Attending to these details lets both voices remain audible.',sources=['mark6','john6'],transform='shared-scene')
R('gospel-emphases','jewish-world','context-reading','Read the Gospels in their Jewish setting','The Passover detail connects John’s story to a Jewish festival. Context can deepen a reading without reducing Judaism to a background prop or making every Gospel voice identical.',sources=['john6','nostra'],transform='gospel-emphases')
R('context-reading','neighbor-care','gospel-notebook','Gospel notebook: story, setting, and response','Our notebook now keeps three questions together: what does the passage say, how does its setting matter, and what response does it invite? An ethical application is not the same thing as proving a historical claim.',sources=['luke10','dei-verbum'],transform='context-reading')
S('gospels','2 · Listen to different Gospel voices','The exhibition needs more than a favorite sentence. Keep your earlier reading of mercy, and compare how two Gospel writers tell a shared scene.',['luke-prologue','mark-bread','john-bread','jewish-world'],['neighbor-care','parable-response'],[('shared-scene','Find the shared scene',True,[]),('gospel-notebook','Build the Gospel notebook',False,[1])])
# 3: transmission and faith/reason before the print/Reformation chapter.
I('copy-paper','Paper for a classroom hand-copy')
I('kells-record','Book of Kells: a Gospel book from about 800','The Book of Kells preserves the four Gospels in Latin in a richly decorated manuscript made around 800. It is evidence of religious reading, skilled handwork, and the effort of preserving texts. Our paper copy is a modern classroom model, not a replica of its materials.','Historical object summary — Trinity College Dublin, Book of Kells collection.',['kells'])
I('aristotle-leaf','Aristotle asks for reasons, not only assertions','Aristotle’s works developed arguments about nature and knowledge in ancient Greece. Medieval readers did not receive a single untouched package: they worked with translations and interpretations.','Editorial historical introduction; reception context in Benedict XVI’s 2 June 2010 account of Aquinas.',['aquinas'])
I('translation-record','Greek, Arabic, and Latin readers share and debate ideas','Medieval scholarship crossed languages and religious communities. Arabic-language thinkers interpreted Aristotle; Latin scholars also obtained translations from Greek. Transmission included new arguments, not simply carrying books from one shelf to another.','Historical summary focused on Aquinas’s intellectual setting; Benedict XVI, 2 June 2010. Not a claim that every work followed one route.',['aquinas'])
I('aquinas-leaf','Aquinas considers objections before answering','Thomas Aquinas, a thirteenth-century member of the Dominican religious order, studied Aristotle and his interpreters. In his theological writing, he sets out objections, gives an answer, and returns to the objections. He argues that faith and reason need not be enemies.','Catholic intellectual tradition — editorial paraphrase of Aquinas’s method and Benedict XVI’s 2 June 2010 account; not a proof of his conclusions.',['aquinas','summa'])
I('seed-diary','Class case: two seed trays give different results','Invented classroom record: two trays were placed in different conditions. One grew more. The record does not yet isolate the cause because light, water, and temperature were not controlled. A repeat comparison could help.','Fictional science-learning case. No experiment has been conducted, and no student information is collected.')
I('creation-reading','Catholic belief: creation is a gift with responsibilities','Catholic teaching describes the world as God’s creation and calls people to care for it. That belief can motivate careful study; it does not replace measurements or supply the missing controls in an experiment.','Catholic framing, editorial summary of Laudato Si’ §§62–69.',['laudato'])
R('gospel-notebook','copy-paper','hand-copy','A Gospel passage copied by hand','This classroom copy makes the work of transmission visible. A copied text needs checking against its source. Copying a passage does not by itself establish whether its account is historically true.',transform='copy-paper')
R('hand-copy','kells-record','manuscript-guide','A manuscript carries words across centuries','Our classroom copy helps us notice the labor in a much older Gospel manuscript. The Book of Kells is one surviving object, not evidence that Christian monasteries were the only places preserving knowledge.',sources=['kells'])
R('aristotle-leaf','translation-record','shared-scholarship','Arguments travel across languages and communities','Aquinas’s setting shows how Latin Christian learning drew on Greek philosophy and Arabic-language interpretation. Readers also disagreed with what they received. Borrowing an argument does not mean accepting every belief of its author.',sources=['aquinas'])
R('shared-scholarship','aquinas-leaf','faith-reason','Aquinas brings reasoned questions into theology','Aquinas engages arguments from outside his own Christian tradition. His aim is to understand faith more carefully, not to declare that thinking is unnecessary once someone believes.',sources=['aquinas','summa'],transform='shared-scholarship')
R('seed-diary','creation-reading','fitting-evidence','A belief about creation is not a test result','The seed case asks what caused a measured difference. The creation text speaks of God and responsibility. These questions can interact, but one kind of answer cannot silently do the work of the other.',sources=['laudato'])
R('faith-reason','fitting-evidence','careful-questions','Questions deserve reasons that fit the claim','Aquinas’s theological reasoning and the invented seed comparison are not the same method. Both invite attention to reasons, limits, and objections. This comparison does not make science and religion identical or permanently separate.',transform='faith-reason',incorporate=['fitting-evidence'])
R('manuscript-guide','careful-questions','sources-reasons','Sources notebook: where a claim comes from matters','A text has a history of copying, translation, and reading. An argument has reasons that can be examined. Keep both records visible instead of treating a respected source as an automatic answer.',transform='manuscript-guide')
S('books','3 · Books, borders, and questions','Follow the Gospel book into medieval reading rooms, then meet Aquinas’s questions. Different communities help texts and arguments travel.',['copy-paper','kells-record','aristotle-leaf','translation-record','aquinas-leaf','seed-diary','creation-reading'],['gospel-notebook'],[('hand-copy','Make a careful hand-copy',True,[]),('sources-reasons','Keep sources and reasons together',False,[1])])
# 4: history is not a victory ladder. Two press actions use the existing location grammar.
I('gutenberg-record','Mainz, about 1455: a Bible printed in Latin','Gutenberg’s Bible used movable metal type in fifteenth-century Mainz. Hand decoration remained part of some copies. This was important in European printing, not the beginning of all printing: printing traditions existed earlier in Asia.','Historical object summary — Library of Congress, Gutenberg Bible. The wider chronology is a safeguard against a Europe-only invention claim.',['gutenberg','printing-asia'])
I('luther-theses','1517: Luther challenges claims about indulgences','Luther’s Ninety-five Theses disputed the preaching and practice of indulgences. He argued, among other things, that care for a person in need matters more than purchasing an indulgence. Do not reduce the controversy to buying permission to sin.','Historical and textual paraphrase — Luther, Ninety-five Theses, especially 43–45; National Library of Scotland’s printing history.',['luther','reformation'])
I('catholic-response','Catholic teaching distinguishes pardon from an indulgence','In Catholic teaching, forgiveness of guilt and healing the lasting effects of sin are distinct. An indulgence concerns the remaining purification called temporal punishment—not permission to sin. This is a present-day Catholic explanation, not a transcript of every sixteenth-century claim. Abuses in preaching and fundraising remain historical questions.','Catholic doctrinal distinction — Catechism of the Catholic Church §§1471–1473; the current explanation is not a 1517 response document.',['indulgence'])
I('unity-text','Vatican II calls Christians to dialogue, not caricature','In 1964, Vatican II urged Catholics to work toward Christian unity through renewal, dialogue, and cooperation. This does not mean the disagreements of the Reformation disappeared or all churches became the same.','Catholic teaching — editorial paraphrase of Unitatis Redintegratio §§1–4.',['unity'])
R('hand-copy','@printing-workshop','printed-gospel','A Gospel page made for repeated printing','The classroom workshop models a change in reproduction: a prepared text can yield repeated impressions. It does not recreate the full technology or claim this particular hand-copy was Gutenberg’s source.',transform='hand-copy')
R('printed-gospel','gutenberg-record','print-churches','Printing changes how religious texts circulate','Gutenberg’s Latin Bible connects Church history with craft and book history. More copies can reach readers, but printing does not guarantee access for everyone or make a printed claim true.',sources=['gutenberg'],transform='printed-gospel')
R('luther-theses','@printing-workshop','reform-pamphlet','A reform argument travels in print','Early printing helped Luther’s arguments spread beyond a local academic discussion. The Reformation was a sixteenth-century movement that reshaped and divided Western Christianity. This classroom pamphlet stands for circulation; print alone did not cause that movement.',sources=['reformation'])
R('reform-pamphlet','catholic-response','disputed-claims','Separate the disputed practice from the stated teaching','Luther’s challenge and the Catholic definition are not identical kinds of evidence. Comparing them reveals a dispute over practice, authority, and grace—not a contest between thoughtful people and people who never asked questions.',sources=['luther','indulgence'],transform='reform-pamphlet')
R('disputed-claims','sources-reasons','fair-disagreement','A fair account lets each argument be heard','Name who makes a claim, check what the claim actually says, and distinguish it from later summaries. Fairness does not require pretending the disagreement is small.',transform='disputed-claims')
R('fair-disagreement','unity-text','history-dialogue','Disagreement can be studied without contempt','The exhibition can describe real Christian divisions while showing later efforts at dialogue. A call for respect is not proof that every historical conflict has been resolved.',sources=['unity'],transform='fair-disagreement')
S('printing','4 · Print, reform, and disagreement','The chronology moves from medieval manuscripts to fifteenth-century printing, the Reformation, and a later Catholic call for dialogue. Keep the sources notebook open.',['gutenberg-record','luther-theses','catholic-response','unity-text'],['hand-copy','sources-reasons'],[('print-churches','Trace the printed Bible',False,[]),('disputed-claims','Identify the actual dispute',True,[]),('history-dialogue','Write a fair account of disagreement',False,[2])],['printing-workshop'])
# 5: no real personal disclosure; all observations fictional.
I('examen-card','The Examen: review a day with God','The Ignatian Examen is a Christian prayer of attention: gratitude, an honest review of the day, asking for help or forgiveness, and looking toward tomorrow. This game studies a fictional journal; it does not ask you to report a prayer or disclose your beliefs.','Ignatian practice — original summary informed by Loyola Press, Try the Daily Examen.',['examen'])
I('fictional-journal','Case journal: I stayed quiet when a classmate was left out','Invented case: a club organizer notices that a new student sat alone while teams formed. The organizer felt awkward and said nothing. Later, the student offered a useful idea. No real student is described here.','Fictional classroom case; not a prompt to submit personal experiences.')
I('club-options','The club could invite a speaker or hold a listening meeting','Invented choice: one activity brings an interesting speaker; another gives quieter members time to help plan. Neither label alone tells us which choice best fits the club’s current needs.','Fictional classroom choice. The game offers a defensible plan, not the only morally acceptable decision.')
I('club-effects','A speaker informs; a listening meeting lets members shape the plan','Invented planning note: the club has already heard two speakers, but new members have not been asked what they need. A listening meeting would address that particular gap.','Fictional case evidence, not a universal rule against guest speakers.')
I('week-later','A week later: quieter members ask for smaller discussion groups','Invented follow-up: several members say the large meeting is still difficult to join. They suggest small groups and a way to contribute in writing. The organizer can revise the plan instead of treating good intentions as the end.','Fictional case follow-up; no student feedback was collected.')
R('examen-card','fictional-journal','day-review','An honest review notices gifts and missed chances','The fictional organizer can be grateful for the new student’s idea and still face the earlier silence. In the Examen, reflection takes place in relationship with God; it is more than a productivity score.',sources=['examen'])
R('day-review','neighbor-care','noticed-neighbor','The overlooked classmate is not outside our concern','The Gospel reading brings a question to this invented case: whom did the organizer fail to notice? A modern application is not a claim that the Gospel describes this exact classroom.',transform='day-review')
R('club-options','club-effects','weighed-options','For this club, listening addresses the missing voice','Compare the actual effects rather than choosing the most impressive-sounding event. In this case, the evidence favors making room for new members first.')
R('noticed-neighbor','weighed-options','discernment-plan','Choose a listening meeting and review what happens','The plan links reflection to a concrete action and a later check. Ignatian discernment includes prayer and attention to motives and effects; it is not a machine that guarantees God’s will from two cards.',sources=['examen'],transform='noticed-neighbor',incorporate=['weighed-options'])
R('discernment-plan','week-later','revised-action','Good intentions grow into a revised action','The organizer keeps the aim of inclusion but changes the format. Listening continues after a decision. The game assesses the reasoning of a fictional plan, not anyone’s holiness.',transform='discernment-plan')
S('discernment','5 · Reflection becomes action','Return to a present-day classroom case, using an Ignatian practice with sixteenth-century roots. No personal confession, belief statement, or prayer record is requested.',['examen-card','fictional-journal','club-options','club-effects','week-later'],['neighbor-care','history-dialogue'],[('noticed-neighbor','Notice who was overlooked',True,[]),('revised-action','Revise the club’s action',False,[1])])
# 6: specific living traditions, not mix-and-match beliefs.
I('shabbat-account','A Jewish account of Shabbat: sacred weekly rest','Chabad, an Orthodox Jewish organization, describes Shabbat as sacred time connected to creation, with limits on creative work. Jewish communities and individuals observe Shabbat in different ways. This is one Jewish account, not a rule for every Jewish person.','Original summary of Chabad’s A Short Guide to Shabbat Rest.',['shabbat'])
I('saturday-plan','Case: the proposed event is during a guest’s Shabbat','Invented case: a guest says that this Saturday event conflicts with their Shabbat observance. The guest has explained their own practice; classmates should not assume they speak for all Jews.','Fictional interfaith-planning case.')
I('ramadan-account','A Muslim account of Ramadan: fasting and devotion','ING’s Muslim educators describe fasting in Ramadan as one of Islam’s central practices, alongside worship and generosity. Observance and exemptions vary. Ask a person about their needs instead of assuming every Muslim is fasting.','Original summary of INGYouth FAQ; ING identifies its perspective as largely Sunni and not representative of every Muslim.',['ramadan'])
I('meal-invitation','Case: a guest asks to join the meal after sunset','Invented case: a Muslim guest who is observing Ramadan asks whether the shared meal can begin after sunset. This is a stated request, not a guess based on the guest’s name or appearance.','Fictional interfaith-planning case; not religious or medical fasting advice.')
I('metta-text','A Buddhist text extends kindness to all beings','The Karaniya Metta Sutta encourages goodwill without hatred toward living beings near and far. It belongs to Buddhist teaching and practice, not to Christian doctrine under a different name. Buddhist traditions are themselves diverse.','Original brief summary of Sutta Nipata 1.8; consulted the Amaravati Sangha translation at Access to Insight. No translation passage is reproduced.',['metta'])
I('nostra-text','Catholic teaching: learn from other religions with respect','Nostra Aetate asks Catholics to approach other religions with respect and dialogue. It also affirms Catholic faith in Christ. Respect does not require calling all religions identical, and differences do not excuse hostility.','Catholic framing — original summary of Vatican II, Nostra Aetate §§2–4.',['nostra'])
R('shabbat-account','saturday-plan','respect-time','Ask the guest about a time they can attend','The guest has already identified a conflict. A respectful plan makes space to discuss alternatives without turning one person into a spokesperson for an entire tradition.')
R('ramadan-account','meal-invitation','shared-meal','Plan a meal that includes the guest’s stated needs','In this invented case, an evening meal answers a specific request. Inclusion starts with listening, not with testing whether a guest practices religion correctly.')
R('metta-text','neighbor-care','similar-not-same','Concern for others can have different religious roots','The Gospel story and the Buddhist text both widen concern beyond a narrow circle. Their teachings, practices, and accounts of ultimate reality are not interchangeable. This is a comparison, not a claim of direct historical borrowing.',sources=['metta','luke10'])
R('similar-not-same','nostra-text','respect-difference','Respectful comparison keeps differences visible','Catholic dialogue can recognize another tradition’s insight without absorbing it into Christianity. The exhibition should identify whose teaching it is and let the differences remain real.',sources=['nostra'],transform='similar-not-same')
R('respect-time','shared-meal','room-for-practice','A shared event can make room for different practices','Two guests have named different needs. The organizers can discuss the schedule and meal with them. Participation does not require guests to hide their traditions.',transform='respect-time',incorporate=['shared-meal'])
R('room-for-practice','respect-difference','dialogue-guide','Dialogue guide: listen, name differences, make room','The guide joins fair comparison with practical hospitality. It does not rank religions, grade belief, or claim three examples can represent all the world’s traditions.',transform='room-for-practice')
S('dialogue','6 · Neighbors with different traditions','The class is planning an imaginary interfaith gathering. Work with specific texts and guests’ stated needs—not stereotypes. These three examples are a beginning, not a world-religions survey.',['shabbat-account','saturday-plan','ramadan-account','meal-invitation','metta-text','nostra-text'],['neighbor-care','revised-action'],[('respect-difference','Compare without erasing differences',True,[]),('dialogue-guide','Prepare a respectful gathering guide',False,[1])])
# 7: urgent care and structures, affected people's agency.
I('pantry-request','Case: the pantry needs food for this week','Invented community note: the pantry has fewer supplies than expected, and families need food now. The immediate need is real within the case even while longer-term causes are examined.','Fictional social-action case; no real organization or family is described.')
I('access-report','Case: pantry hours overlap with work and bus service is limited','Invented access report: some neighbors cannot reach the pantry during its opening hours. More food alone will not fix that barrier. The report is a starting point to check with the people affected.','Fictional case evidence; not data about a real neighborhood.')
I('dignity-card','Catholic social teaching: dignity, participation, and the common good','Catholic social teaching places human dignity at the center and emphasizes participation, solidarity, and concern for people in poverty. People receiving help are agents with knowledge and choices, not merely objects of generosity.','Catholic framing — original summary of USCCB, Seven Themes of Catholic Social Teaching.',['cst'])
I('neighbors-voices','Case: neighbors propose later hours and help choose the food','Invented consultation: pantry users ask for one later opening and a say in what is stocked. They bring expertise about daily needs. An organizer’s assumptions should not replace these voices.','Fictional consultation; no real community feedback has been collected.')
R('pantry-request','neighbor-care','immediate-help','Meet an urgent need without waiting for a perfect system','The case calls for food this week. Acting on the Gospel reading of mercy need not wait until every cause of hardship is understood.')
R('access-report','dignity-card','access-justice','Fair access concerns how the service is organized','The hours and transport barrier raise a question about the structure of the service, not the worthiness of its users. Catholic social teaching gives a reason to examine participation and access.',sources=['cst'])
R('dialogue-guide','neighbors-voices','shared-planning','Plan with neighbors, not only for them','The earlier dialogue guide now matters in a social-action case. Affected people can shape the response rather than simply be thanked for telling their stories.')
R('immediate-help','access-justice','help-and-change','Immediate help and fairer access belong together','Food for this week and changes to access answer different parts of the same case. Neither makes the other unnecessary.',transform='immediate-help',incorporate=['access-justice'])
R('help-and-change','shared-planning','justice-plan','Service plan: supply food and test better hours together','This is one defensible response to the invented evidence: meet the immediate shortage and trial a later opening with neighbors’ input. It remains open to revision; it is not a political loyalty test.',transform='help-and-change',incorporate=['shared-planning'])
S('justice','7 · Help now, change what blocks access','The imagined pantry has both a shortage and an access problem. Bring the Gospel reading and the dialogue guide into a plan made with the people affected.',['pantry-request','access-report','dignity-card','neighbors-voices'],['neighbor-care','dialogue-guide'],[('immediate-help','Respond to this week’s need',True,[]),('justice-plan','Plan help and fairer access together',False,[1])])
# 8: careful evidence + Catholic ethics + participation, then a concrete guide.
I('water-notes','Case: bottles fill the bins; one fountain is often closed','Invented school observations: disposable bottles are common, and a fountain is often unavailable. These notes do not yet tell us the cost, safety, or water use of each possible change. Check before making a confident claim.','Fictional environmental-planning case; no real school survey was conducted.')
I('common-home','Laudato Si’: care for the earth and for people together','Pope Francis’s 2015 encyclical links ecological concern with human dignity, especially the lives of people who bear heavy burdens. It invites dialogue and attention to local conditions, not an automatic answer to every technical choice.','Catholic social teaching — original summary of Laudato Si’ §§49, 137–139, 183.',['laudato'])
I('water-costs','Case: repairs help access; reusable bottles cost money','Invented options note: repairing the fountain improves access. A reusable-bottle plan also has costs and cleaning needs; some families cannot pay an extra fee. No option should be chosen on an untested environmental slogan.','Fictional options note. Actual water safety, engineering, or purchasing decisions require qualified local assessment.')
