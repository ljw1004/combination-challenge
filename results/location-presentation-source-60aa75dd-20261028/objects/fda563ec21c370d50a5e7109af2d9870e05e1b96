function thing(t:M.Token,placed=false){
 const notice=animate?play.notice:null,origin=notice?.nudged?.find(n=>n.id===t.id)?.from??notice?.origin,board=document.querySelector<HTMLElement>('.board'),width=board?.clientWidth??1000,height=board?.clientHeight??700;
 const birth=origin?`--birth-x:${(origin.x-t.x)*width/100}px;--birth-y:${(origin.y-t.y)*height/100}px;`:'';
 const size=M.tokenSize(t),slots=M.roverSlots(t),label=M.concept(t.kind)!.label,functional=slots.length&&M.hasCapability(t,'solar-travel');
 const description=slots.length?`${label}. ${functional?'Ready to drive':'Not ready to drive'}. ${slots.map(slot=>slot.filled?`${slot.label}: installed`:'Empty component slot').join('. ')}${t.slots?.radio?M.hasCapability(t,'solar-radio')?'. Radio is solar-powered.':'. Working radio installed.':''}`:label;
 const contents=slots.length?`<span class="thing-name">${esc(label)}</span><span class="component-slots">${slots.map(slot=>`<span class="component-slot ${slot.filled?'filled':'empty'}" data-slot="${t.id}:${slot.id}" aria-label="${slot.filled?esc(slot.label)+': installed':'Empty component slot'}">${slot.filled?`<span class="slot-mark" aria-hidden="true">✓</span><span>${esc(slot.id==='charger'?'Charger':slot.label)}</span>`:''}</span>`).join('')}</span>`:esc(label);
 return `<button class="thing ${slots.length?'composite':''} ${selected===t.id?'selected':''} ${notice?.created===t.id?'born':''} ${notice?.updated===t.id?'installed':''} ${notice?.moved===t.id||notice?.nudged?.some(n=>n.id===t.id)?'recoil':''} ${notice?.displaced===t.id?'returned':''} ${placed?'placed':''}" data-thing="${t.id}" data-slot-count="${slots.length}" style="--card-width:${size.width}cqw;--card-height:${size.height}cqh;${placed?'':`left:${t.x}%;top:${t.y}%;`}${birth}" aria-label="${esc(description)}">${contents}</button>`;
}
function goalHtml(g:ReturnType<typeof M.goalStates>[number]){return `<h2>${esc(g.title)}</h2><p>${esc(g.requirement)}</p><p class="goal-status">${g.current?'Currently satisfied.':g.achieved?'Satisfied earlier; not currently in place.':'Not yet satisfied.'}</p>`;}
function render(){const previousView=document.querySelector<HTMLElement>('.viewport');const scroll=previousView?{x:previousView.scrollLeft,y:previousView.scrollTop}:null;animate=state().actions!==animatedAction;animatedAction=state().actions;const s=state(),l=M.level(s),pos=M.mapPositions(s),pending=play.queue[0]?taskFor(play.queue[0]):undefined;app.innerHTML=`<div class="debug"><b>MARS · NAMED THINGS / PLAYTEST</b><select id="jump" aria-label="Prepared checkpoint"><option value="">Jump to checkpoint…</option>${M.fixtures.map(f=>`<option value="${f.id}">${esc(f.label)}</option>`).join('')}</select><button id="reset">Reset</button><button id="undo" ${play.history.length?'':'disabled'}>Undo</button><button id="reopen">Reopen objectives</button><a href="mars-v2.html">Previous Mars rules</a><a href="ux-lab.html">Earlier staged playtest</a><span class="narrow-note">Small screen: scroll the board to explore. Things keep their positions.</span>${play.debug?`<span>DEBUG: ${esc(play.debug)}</span>`:''}</div>
 <div class="viewport" aria-label="Scrollable board on narrow screens"><main class="board" aria-label="Things and encountered locations">${NAMED_LOCATIONS.filter(p=>s.revealed.includes(p.id)).map(p=>`<div class="location ${s.tokens.some(t=>t.location===p.id&&t.kind==='rover')?'composite-place':''}" data-place="${p.id}" role="button" tabindex="0" aria-label="${esc(p.label)}" style="left:${pos[p.id].x}%;top:${pos[p.id].y}%;${s.tokens.some(t=>t.location===p.id&&t.kind==='rover')?`--occupant-height:${M.tokenSize(s.tokens.find(t=>t.location===p.id)!).height}cqh;`: ''}"><span>${esc(p.label)}</span>${s.tokens.filter(t=>t.location===p.id).map(t=>thing(t,true)).join('')}</div>`).join('')}${s.tokens.filter(t=>!t.location).map(t=>thing(t)).join('')}<p id="feedback" class="feedback" role="status" hidden></p></main></div>
 <div class="controls">${s.introduced.length>1?'<button id="tasks">Objectives</button>':''}${NAMED_LEVELS.indexOf(l)<s.unlocked?`<button id="next">Continue · ${esc(NAMED_LEVELS[NAMED_LEVELS.indexOf(l)+1].label)}</button>`:''}${selected?'<button id="cancel">Cancel selection</button>':''}${storageWarning?`<small>${esc(storageWarning)}</small>`:''}</div>
 <dialog id="modal">${play.welcome?`<span class="eyebrow">A small landing</span><h1>Make something useful.</h1><p>All your stranded supplies are already here. Start by bringing the broken radio and cable together.</p><p>Things are rounded rectangles. Places are hollow squares. Hover a thing to see where a new possibility exists; drag or click two things to try it.</p><p>A Rover holds its own parts. Explore compatible parts to fill its empty spaces and make it ready to drive. Parts with other uses keep a reusable copy outside; other parts move inside. Places appear as objectives need them.</p><button id="start" class="primary">Begin</button>`:pending?`<span class="eyebrow">New objective</span>${goalHtml(pending)}${pending.requiredLocations.some(id=>NAMED_RECIPES.some(r=>r.at===id))?'<p>Some combinations need a setting. Put one thing at the repair bench, then bring another thing onto it. The place never collects or merges things on its own.</p>':''}${play.notice?.created?`<p class="result-confirmation">You made ${esc(name(play.notice.created))}.</p>`:''}<button id="ack-task" class="primary">Understood</button>`:showTasks?`<button id="close-tasks">Close</button><span class="eyebrow">Your objectives</span>${NAMED_LEVELS.map(level=>{const goals=M.goalStates(s,level.id).filter(g=>s.introduced.includes(g.id));return goals.length?`<section><h3>${esc(level.label)}</h3>${goals.map(goalHtml).join('')}</section>`:'';}).join('')}`:''}<button id="reset-modal" class="reset-modal">Restart from beginning</button></dialog>`;
 bind();const viewport=document.querySelector<HTMLElement>('.viewport')!,board=document.querySelector<HTMLElement>('.board')!;if(scroll){viewport.scrollLeft=scroll.x;viewport.scrollTop=scroll.y;}else{viewport.scrollLeft=Math.max(0,(board.clientWidth-viewport.clientWidth)/2);viewport.scrollTop=Math.max(0,(board.clientHeight-viewport.clientHeight)/2);}if(animate&&play.notice?.created)targetElement(play.notice.created)?.scrollIntoView?.({block:'nearest',inline:'nearest'});const modal=document.querySelector<HTMLDialogElement>('#modal')!;if(play.welcome||pending||showTasks){modal.showModal();modal.oncancel=e=>{e.preventDefault();if(!play.welcome&&!pending){showTasks=false;render();}};}}
function clearHighlights(){document.querySelectorAll<HTMLElement>('[data-thing],[data-place],[data-slot]').forEach(el=>el.classList.remove('possible','will-create','will-place'));}
function targetElement(id:string){return id.startsWith('place:')?document.querySelector<HTMLElement>(`[data-place="${id.slice(6)}"]`):document.querySelector<HTMLElement>(`[data-thing="${id}"]`);}
function highlight(id:string){clearHighlights();const partners=M.novelPartners(state(),id);if(!partners.length)return;targetElement(id)?.classList.add('possible');partners.forEach(p=>{targetElement(p)?.classList.add('possible');highlightSlot(M.creation(state(),id,p),'possible');});}
function highlightSlot(result:M.Result|null,style:string){if(result?.installed)document.querySelector<HTMLElement>(`[data-slot="${result.installed.rover}:${result.installed.slot}"]`)?.classList.add(style);}
function targetId(el:Element|null):string|undefined{const found=el?.closest<HTMLElement>('[data-thing],[data-place]');return found?.dataset.thing??(found?.dataset.place?'place:'+found.dataset.place:undefined);}
function pointFrom(e:{clientX:number;clientY:number}){const r=document.querySelector<HTMLElement>('.board')!.getBoundingClientRect();return {x:(e.clientX-r.left)/r.width*100,y:(e.clientY-r.top)/r.height*100};}
function bind(){const on=(id:string,fn:()=>void)=>{const el=document.getElementById(id);if(el)el.onclick=fn;};on('start',()=>{play.welcome=false;save();render();});on('ack-task',()=>{play=M.dismissTask(play);save();render();});on('reopen',()=>{play=M.reopenTasks(play);save();render();});on('tasks',()=>{showTasks=true;render();});on('close-tasks',()=>{showTasks=false;render();});on('cancel',()=>{selected='';render();});on('next',()=>{const index=NAMED_LEVELS.findIndex(l=>l.id===state().level);play=M.visit(play,NAMED_LEVELS[index+1].id);selected='';save();render();});on('undo',()=>{play=M.undo(play);selected='';save();render();});const reset=()=>{if(confirm('Start this named-things playtest again? The previous Mars prototype keeps its own save.')){drag=null;selected='';showTasks=false;suppressClick=false;animatedAction=-1;animate=false;play=M.fresh();save();render();}};on('reset',reset);on('reset-modal',reset);const jump=document.querySelector<HTMLSelectElement>('#jump')!;jump.onchange=()=>{if(!jump.value)return;play=M.debugJump(jump.value);selected='';showTasks=false;save();render();};
 document.querySelectorAll<HTMLElement>('[data-thing]').forEach(el=>{el.onmouseenter=()=>{if(!drag)highlight(el.dataset.thing!);};el.onmouseleave=()=>{if(!drag)clearHighlights();};el.onfocus=()=>{if(!drag)highlight(el.dataset.thing!);};el.onclick=e=>{e.stopPropagation();if(!suppressClick)choose(el.dataset.thing!);};el.ondragstart=e=>e.preventDefault();});document.querySelectorAll<HTMLElement>('[data-place]').forEach(el=>{el.onclick=e=>{e.stopPropagation();if(!suppressClick)choose('place:'+el.dataset.place);};el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();choose('place:'+el.dataset.place);}};});
 const board=document.querySelector<HTMLElement>('.board')!;
 const beginDrag=(target:Element|null,x:number,y:number,pointer:number,touch?:number)=>{const id=targetId(target);if(!id||id.startsWith('place:'))return false;drag={id,startX:x,startY:y,moved:false,element:targetElement(id)!,pointer,...touch===undefined?{}:{touch}};highlight(id);return true;};
 const moveDrag=(x:number,y:number)=>{if(!drag)return;if(!drag.moved&&Math.hypot(x-drag.startX,y-drag.startY)<5)return;drag.moved=true;const p=pointFrom({clientX:x,clientY:y}),el=drag.element;if(el.parentElement!==board)board.appendChild(el);el.classList.remove('placed');el.classList.add('dragging');el.style.left=p.x+'%';el.style.top=p.y+'%';el.style.pointerEvents='none';highlight(drag.id);const target=targetId(document.elementFromPoint(x,y));if(target&&target!==drag.id){const result=M.creation(state(),drag.id,target);if(result){highlightSlot(result,'will-create');el.classList.remove('possible');targetElement(target)?.classList.remove('possible');el.classList.add('will-create');targetElement(target)?.classList.add('will-create');}else if(target.startsWith('place:'))targetElement(target)?.classList.add('will-place');}};
 const endDrag=(x:number,y:number)=>{if(!drag)return;const d=drag;drag=null;suppressClick=true;setTimeout(()=>{suppressClick=false;},0);if(!d.moved){choose(d.id);return;}const target=targetId(document.elementFromPoint(x,y));if(target&&target!==d.id)commit(M.gestureAction(state(),d.id,target));else commit({type:'place',token:d.id,location:null,...pointFrom({clientX:x,clientY:y})});};
 const cancelDrag=()=>{if(!drag)return;drag=null;render();};
 // Pointer-only devices keep capture; Touch Events adopt the same drag so an actual
 // item gesture can cancel browser scrolling without disabling empty-board pans.
