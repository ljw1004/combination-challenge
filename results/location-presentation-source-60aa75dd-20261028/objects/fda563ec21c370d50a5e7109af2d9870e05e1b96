 board.onpointermove=e=>{if(drag?.touch===undefined)moveDrag(e.clientX,e.clientY);};
 board.onpointerup=e=>{if(drag?.touch===undefined)endDrag(e.clientX,e.clientY);};
 board.onpointercancel=e=>{if(drag?.touch===undefined)cancelDrag();};
 board.addEventListener('touchstart',e=>{const t=e.changedTouches[0];if(drag){if(t&&drag.pointerTouch&&drag.touch===undefined&&targetId(e.target as Element)===drag.id)drag.touch=t.identifier;if(drag.touch!==undefined)e.preventDefault();return;}if(t&&beginDrag(e.target as Element,t.clientX,t.clientY,-1,t.identifier))e.preventDefault();},{passive:false});
 board.addEventListener('touchmove',e=>{if(drag?.touch===undefined)return;const t=Array.from(e.touches).find(t=>t.identifier===drag!.touch);if(!t)return;e.preventDefault();moveDrag(t.clientX,t.clientY);},{passive:false});
 board.addEventListener('touchend',e=>{if(drag?.touch===undefined)return;const t=Array.from(e.changedTouches).find(t=>t.identifier===drag!.touch);if(!t)return;e.preventDefault();endDrag(t.clientX,t.clientY);},{passive:false});
