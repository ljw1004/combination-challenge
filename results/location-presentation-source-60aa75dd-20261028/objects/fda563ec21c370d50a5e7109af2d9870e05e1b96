let drag:{id:string;startX:number;startY:number;moved:boolean;element:HTMLElement;pointer:number;touch?:number;pointerTouch?:boolean}|null=null;
const esc=(s:unknown)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
