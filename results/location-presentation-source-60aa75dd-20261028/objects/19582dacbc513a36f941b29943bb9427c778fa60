function explore(entry,width){
 const queue=[M.checkpoint(s,entry,width)],seen=new Set(),edges=[],terminals=[],terminalViews=[],recipes=new Set();let reverseChecks=0,undoChecks=0,restoreChecks=0;
 for(let cursor=0;cursor<queue.length;cursor++){
  const g=queue[cursor],k=sig(g);if(seen.has(k))continue;seen.add(k);
  assert.deepEqual(M.restore(s,JSON.stringify(g)),g);restoreChecks++;
  let productive=0;
  for(const r of s.recipes.filter(r=>[r.a,r.b].every(id=>g.state.tokens.some(t=>t.kind===id&&t.area===g.state.currentArea)))){
   const x=M.applyAction(s,g,{type:'combine',a:r.a,b:r.b});if(!x.accepted)continue;
   assert(m.newRecipes.includes(r.id));
   const y=M.applyAction(s,g,{type:'combine',a:r.b,b:r.a});assert(y.accepted);assert.equal(sig(x.game),sig(y.game));reverseChecks++;
   const hi=M.partners(s,g.state,r.a);assert(hi.partners.includes(r.b)||hi.incoming.includes(r.b));
   const undo=M.undo(x.game);assert(undo.accepted);assert.deepEqual(structural(undo.game.state),structural(g.state));
   assert.deepEqual(M.restore(s,JSON.stringify(undo.game)),undo.game);undoChecks++;
   const again=M.applyAction(s,undo.game,{type:'combine',a:r.a,b:r.b});assert(again.accepted);assert.equal(sig(again.game),sig(x.game));
   recipes.add(r.id);edges.push([k,sig(x.game)]);queue.push(x.game);productive++;
  }
  if(!productive){assert(M.stageComplete(s,g.state),'productive terminal must satisfy every objective');terminals.push(k);terminalViews.push(M.playerView(s,g).things.map(t=>({id:t.id,label:t.label,components:t.components.slice().sort(),gold:t.gold})).sort((a,b)=>a.id.localeCompare(b.id)));}
 }
 const canFinish=new Set(terminals);let changed=true;
 while(changed){changed=false;for(const [a,b] of edges)if(canFinish.has(b)&&!canFinish.has(a)){canFinish.add(a);changed=true;}}
 assert.equal(canFinish.size,seen.size,'every productive local state reaches completion');
 for(const view of terminalViews)assert.deepEqual(view,terminalViews[0],'all orders preserve visible final case contents');
 return {entry,width,reachableStates:seen.size,productiveEdges:edges.length,terminalStates:terminals.length,allStatesCanFinish:true,visibleTerminalCaseContentsEqual:true,reverseChecks,undoChecks,restoreChecks,recipesCovered:[...recipes].sort()};
}
